{% extends "base.html" %}
{% block extra_head %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/admin_user_profile.css', v='v163-pager-pinned-bottom-20260505') }}">
<script defer src="{{ url_for('static', filename='js/admin_user_profile.js', v='v163-pager-pinned-bottom-20260505') }}"></script>
{% endblock %}
{% block body %}
{% set is_en = (ui_lang or 'ar') == 'en' %}
{% set _selected_plan = (plans|selectattr('id','equalto', tenant.plan_id)|first) if tenant else None %}
{% set _plan_label = ((_selected_plan.name_en if is_en else _selected_plan.name_ar) if _selected_plan else '—') %}
<div class="app-shell has-layout-sidebar sidebar-collapsed">
  {% include '_sidebar.html' %}
  <main class="app-main content-area up-page" data-up-tab="{{ tab }}" data-up-user-id="{{ user_obj.id }}">
    {# ═══════════════ HERO ═══════════════ #}
    <header class="hu-hero">
      <div class="hu-hero-grid">
        <div class="hu-hero-text">
          <span class="hu-eyebrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {{ 'Subscriber profile' if is_en else 'ملف المشترك' }}
          </span>
          <h1 class="hu-h1">{{ user_obj.full_name or user_obj.username }}</h1>
          <p class="hu-tagline">{{ 'Identity, subscription, support, finance, quotas, devices, and activity — one focused workspace.' if is_en else 'الهوية والاشتراك والدعم والمالية والكوتا والأجهزة والنشاط — مكان عمل واحد مركّز.' }}</p>
          <div class="hu-hero-meta">
            <span class="hu-meta-pill {{ 'ok' if user_obj.is_active else 'warn' }}">{% if user_obj.is_active %}🟢 <b>{{ 'Active' if is_en else 'نشط' }}</b>{% else %}⛔ <b>{{ 'Disabled' if is_en else 'معطّل' }}</b>{% endif %}</span>
            <span class="hu-meta-pill"><b>@{{ user_obj.username }}</b></span>
            {% if user_obj.email %}<span class="hu-meta-pill">📧 <b>{{ user_obj.email }}</b></span>{% endif %}
          </div>
        </div>
        <div class="hu-hero-cta">
          <a class="hu-btn hu-btn-ghost" href="{{ url_for('main.admin_subscribers', lang=ui_lang) }}">← {{ 'Back to subscribers' if is_en else 'العودة للمشتركين' }}</a>
        </div>
      </div>
    </header>

    {# ═══════════════ KPI strip ═══════════════ #}
    <section class="up-stats">
      <article class="up-stat">
        <span class="up-stat-icon">📦</span>
        <small>{{ 'Plan' if is_en else 'الخطة' }}</small>
        <strong>{{ _plan_label }}</strong>
      </article>
      <article class="up-stat s-emerald">
        <span class="up-stat-icon">✅</span>
        <small>{{ 'Subscription' if is_en else 'الاشتراك' }}</small>
        <strong>{{ ui_label(subscription.status, 'status', ui_lang) if subscription else '—' }}</strong>
      </article>
      <article class="up-stat s-amber">
        <span class="up-stat-icon">💰</span>
        <small>{{ 'Wallet' if is_en else 'الرصيد' }}</small>
        <strong>{{ wallet_balance }} <em>USD</em></strong>
      </article>
      <article class="up-stat s-sky">
        <span class="up-stat-icon">⚡</span>
        <small>{{ 'Devices' if is_en else 'الأجهزة' }}</small>
        <strong>{{ devices|length }}</strong>
      </article>
      <article class="up-stat s-violet">
        <span class="up-stat-icon">🎧</span>
        <small>{{ 'Open support' if is_en else 'الدعم المفتوح' }}</small>
        <strong>{{ thread_rows|length + ticket_rows|length }}</strong>
      </article>
    </section>

    {# ═══════════════ Tabs nav ═══════════════ #}
    <nav class="up-tabs" role="tablist">
      {% for key, label_ar, label_en, icon in [
        ('profile',      'البيانات الشخصية',  'Personal',     '👤'),
        ('subscription', 'الاشتراك',          'Subscription', '💳'),
        ('support',      'الدعم',             'Support',      '🎧'),
        ('finance',      'المالية',           'Finance',      '💰'),
        ('quotas',       'الكوتا',            'Quotas',       '📊'),
        ('devices',      'الأجهزة',           'Devices',      '⚡'),
        ('activity',     'النشاط',            'Activity',     '⏱'),
      ] %}
        <button type="button" class="up-tab {% if tab == key %}is-active{% endif %}" data-up-tab-btn="{{ key }}" role="tab" aria-selected="{{ 'true' if tab == key else 'false' }}">
          <span class="up-tab-icon">{{ icon }}</span>
          <span class="up-tab-label">{{ label_en if is_en else label_ar }}</span>
        </button>
      {% endfor %}
    </nav>

<div class="up-pane" data-up-pane="profile" {% if tab != 'profile' %}hidden{% endif %}>

<div class="prof-shell">
  {# ─── Identity hero card (with mini-stats — Solution D) ─── #}
  <div class="prof-hero">
    <div class="prof-hero-bg"></div>
    <div class="prof-hero-text">
      <h2>{{ user_obj.full_name or user_obj.username }}</h2>
      <div class="prof-hero-meta">
        <span class="prof-tag">@{{ user_obj.username }}</span>
        {% if user_obj.email %}<span class="prof-tag prof-tag-email">📧 {{ user_obj.email }}</span>{% endif %}
        {% if user_obj.phone_number %}<span class="prof-tag">📱 {{ user_obj.phone_country_code or '' }} {{ user_obj.phone_number }}</span>{% endif %}
        <span class="prof-tag prof-tag-loc">📍 {{ user_obj.city or '—' }} · {{ user_obj.country or '—' }}</span>
        <span class="prof-tag prof-tag-tz">🕒 {{ user_obj.timezone or 'Asia/Hebron' }}</span>
      </div>
      <div class="prof-hero-stats">
        <div class="prof-mini">
          <span class="prof-mini-icon" style="background:linear-gradient(135deg,#a78bfa,#7c3aed)">📅</span>
          <div class="prof-mini-body">
            <small>{{ 'Subscription' if is_en else 'الاشتراك' }}</small>
            <strong>{% if subscription_day_info.days_left is not none %}{{ subscription_day_info.days_left }} {{ 'days' if is_en else 'يوم' }}{% else %}—{% endif %}</strong>
          </div>
        </div>
        <div class="prof-mini">
          <span class="prof-mini-icon" style="background:linear-gradient(135deg,#34d399,#059669)">⚡</span>
          <div class="prof-mini-body">
            <small>{{ 'Devices' if is_en else 'الأجهزة' }}</small>
            <strong>{{ devices|length }}</strong>
          </div>
        </div>
        <div class="prof-mini">
          <span class="prof-mini-icon" style="background:linear-gradient(135deg,#fbbf24,#d97706)">💬</span>
          <div class="prof-mini-body">
            <small>{{ 'Open cases' if is_en else 'دعم مفتوح' }}</small>
            <strong>{{ (thread_rows|rejectattr('thread.status','in',['closed','resolved'])|list|length) + (ticket_rows|rejectattr('ticket.status','in',['closed','resolved'])|list|length) }}</strong>
          </div>
        </div>
        <div class="prof-mini">
          <span class="prof-mini-icon" style="background:linear-gradient(135deg,#60a5fa,#2563eb)">💰</span>
          <div class="prof-mini-body">
            <small>{{ 'Wallet' if is_en else 'المحفظة' }}</small>
            <strong>{{ '%.2f'|format(wallet_balance or 0) }}</strong>
          </div>
        </div>
      </div>
    </div>
    <div class="prof-hero-avatar">
      <span class="prof-hero-avatar-letter">{{ (user_obj.full_name or user_obj.username or 'U')[:1]|upper }}</span>
      <span class="prof-hero-status {{ 'is-active' if user_obj.is_active else 'is-disabled' }}" title="{{ 'Active' if user_obj.is_active else 'Disabled' }}"></span>
    </div>
  </div>

  <div class="prof-grid">
  <form method="post" class="prof-form" id="prof-form">
    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="action" value="save_profile">

    {# ─── Step 1: Identity ─── #}
    <article class="prof-step">
      <div class="prof-step-side">
        <span class="prof-step-num">1</span>
        <span class="prof-step-icon">🪪</span>
        <small>{{ 'Step 1' if is_en else 'الخطوة 1' }}</small>
        <h3>{{ 'Identity' if is_en else 'الهوية' }}</h3>
        <p>{{ 'Username, name, email & phone — what we use to recognize the subscriber.' if is_en else 'اسم المستخدم والاسم والإيميل والجوال — ما نستخدمه للتعرّف على المشترك.' }}</p>
      </div>
      <div class="prof-step-body">
        <label class="prof-field">
          <span>{{ 'Username' if is_en else 'اسم المستخدم' }} <em>*</em></span>
          <input class="prof-input prof-input-ltr" name="username" value="{{ user_obj.username }}" required>
        </label>
        <label class="prof-field">
          <span>{{ 'Full name' if is_en else 'الاسم الكامل' }}</span>
          <input class="prof-input" name="full_name" value="{{ user_obj.full_name or '' }}" placeholder="{{ 'Subscriber full name' if is_en else 'الاسم الكامل للمشترك' }}">
        </label>
        <label class="prof-field">
          <span>{{ 'Email address' if is_en else 'البريد الإلكتروني' }}</span>
          <input class="prof-input prof-input-ltr" type="email" name="email" value="{{ user_obj.email or '' }}" placeholder="name@example.com">
        </label>
        <label class="prof-field">
          <span>{{ 'Phone' if is_en else 'رقم الجوال' }}</span>
          <div class="prof-phone">
            <select class="prof-input prof-phone-code" name="phone_country_code">
              {% set current_phone_code = user_obj.phone_country_code or '+970' %}
              {% for country in country_options %}
                <option value="{{ country.dial }}" {% if current_phone_code == country.dial %}selected{% endif %}>{{ country.flag }} {{ country.dial }}</option>
              {% endfor %}
            </select>
            <input class="prof-input prof-input-ltr prof-phone-num" name="phone_number" value="{{ user_obj.phone_number or '' }}" placeholder="599000000">
          </div>
        </label>
      </div>
    </article>

    {# ─── Step 2: Location ─── #}
    <article class="prof-step">
      <div class="prof-step-side">
        <span class="prof-step-num">2</span>
        <span class="prof-step-icon">🌍</span>
        <small>{{ 'Step 2' if is_en else 'الخطوة 2' }}</small>
        <h3>{{ 'Location' if is_en else 'الموقع' }}</h3>
        <p>{{ 'Country, city, timezone & UI language — power the dashboard correctly.' if is_en else 'الدولة والمدينة والمنطقة الزمنية ولغة الواجهة — لتعمل الداشبورد بدقة.' }}</p>
      </div>
      <div class="prof-step-body">
        <label class="prof-field">
          <span>{{ 'Country' if is_en else 'الدولة' }}</span>
          <select class="prof-input" name="country" id="prof-country" data-current="{{ user_obj.country or '' }}">
            <option value="">{{ '— Select country —' if is_en else '— اختر الدولة —' }}</option>
            {% for c in country_options %}
              {% set label_value = c.name_en if is_en else c.name_ar %}
              <option value="{{ label_value }}"
                data-code="{{ c.code }}"
                data-tz="{{ c.timezone }}"
                data-cities-ar='{{ c.cities_ar|tojson }}'
                data-cities-en='{{ c.cities_en|tojson }}'
                {% if user_obj.country and (user_obj.country == c.name_ar or user_obj.country == c.name_en) %}selected{% endif %}>
                {{ c.flag }} {{ label_value }}
              </option>
            {% endfor %}
          </select>
        </label>
        <label class="prof-field">
          <span>{{ 'City' if is_en else 'المدينة' }}</span>
          <select class="prof-input" name="city" id="prof-city" data-current="{{ user_obj.city or '' }}">
            <option value="">{{ '— Select city —' if is_en else '— اختر المدينة —' }}</option>
            {% if user_obj.city %}<option value="{{ user_obj.city }}" selected>{{ user_obj.city }}</option>{% endif %}
          </select>
        </label>
        <label class="prof-field">
          <span>{{ 'Timezone' if is_en else 'المنطقة الزمنية' }}</span>
          <select class="prof-input prof-input-ltr" name="timezone" id="prof-timezone">
            {% set current_tz = user_obj.timezone or 'Asia/Hebron' %}
            {% for group in timezone_groups %}
              <optgroup label="{{ group.group_en if is_en else group.group_ar }}">
                {% for item in group['items'] %}
                  <option value="{{ item.tz }}" {% if current_tz == item.tz %}selected{% endif %}>{{ item.label_en if is_en else item.label_ar }}</option>
                {% endfor %}
              </optgroup>
            {% endfor %}
          </select>
        </label>
        <label class="prof-field">
          <span>{{ 'UI language' if is_en else 'لغة الواجهة' }}</span>
          <select class="prof-input" name="preferred_language">
            <option value="ar" {% if (user_obj.preferred_language or 'ar') == 'ar' %}selected{% endif %}>🇸🇦 عربي</option>
            <option value="en" {% if user_obj.preferred_language == 'en' %}selected{% endif %}>🇬🇧 English</option>
          </select>
        </label>
      </div>
    </article>

    {# ─── Step 3: Security & Access ─── #}
    <article class="prof-step">
      <div class="prof-step-side">
        <span class="prof-step-num">3</span>
        <span class="prof-step-icon">🛡️</span>
        <small>{{ 'Step 3' if is_en else 'الخطوة 3' }}</small>
        <h3>{{ 'Security & Access' if is_en else 'الأمان والوصول' }}</h3>
        <p>{{ 'Reset password, set role, and toggle account access.' if is_en else 'إعادة كلمة المرور، تحديد الدور، تفعيل أو تعطيل الحساب.' }}</p>
      </div>
      <div class="prof-step-body">
        <label class="prof-field">
          <span>{{ 'New password' if is_en else 'كلمة مرور جديدة' }}</span>
          <input class="prof-input prof-input-ltr" type="password" name="password" placeholder="{{ 'Leave blank to keep' if is_en else 'فارغة للإبقاء على الحالية' }}" autocomplete="new-password">
        </label>
        <label class="prof-field">
          <span>{{ 'Role' if is_en else 'الدور' }}</span>
          <select class="prof-input" name="role">
            <option value="user" {% if user_obj.role in ['user','subscriber','customer',''] %}selected{% endif %}>{{ 'Subscriber' if is_en else 'مشترك' }}</option>
          </select>
        </label>
        <label class="prof-toggle">
          <input type="checkbox" name="is_active" {% if user_obj.is_active %}checked{% endif %}>
          <span class="prof-toggle-knob"></span>
          <div class="prof-toggle-text">
            <strong>{{ 'Account enabled' if is_en else 'الحساب مُفعَّل' }}</strong>
            <small>{{ 'When disabled, the subscriber cannot sign in.' if is_en else 'عند التعطيل لن يستطيع المشترك تسجيل الدخول.' }}</small>
          </div>
        </label>
      </div>
    </article>

    {# ─── Sticky save bar ─── #}
    <div class="prof-savebar">
      <span class="prof-savebar-hint">💡 {{ 'Press save to apply changes.' if is_en else 'اضغط حفظ لتطبيق التعديلات.' }}</span>
      <div class="prof-savebar-actions">
        <button class="prof-btn prof-btn-primary" type="submit">💾 {{ 'Save profile' if is_en else 'حفظ الملف' }}</button>
      </div>
    </div>
  </form>

  {# ─── Side column (Solution B) ─── #}
  <aside class="prof-side">
    <section class="prof-side-card prof-side-plan">
      <header>
        <span class="prof-side-eyebrow">{{ 'Plan' if is_en else 'الخطة' }}</span>
        <span class="prof-side-state {{ 'is-active' if subscription and subscription.status in ['active','trial'] else 'is-disabled' }}">{{ ui_label(subscription.status, 'status', ui_lang) if subscription else '—' }}</span>
      </header>
      <strong class="prof-side-title">{{ (plans|selectattr('id','equalto', tenant.plan_id)|first).name_en if is_en and (plans|selectattr('id','equalto', tenant.plan_id)|first) else ((plans|selectattr('id','equalto', tenant.plan_id)|first).name_ar if (plans|selectattr('id','equalto', tenant.plan_id)|first) else ('No plan' if is_en else 'بدون خطة')) }}</strong>
      <div class="prof-side-rows">
        <div><span>{{ 'Days left' if is_en else 'الأيام المتبقية' }}</span><b>{% if subscription_day_info.days_left is not none %}{{ subscription_day_info.days_left }}{% else %}—{% endif %}</b></div>
        <div><span>{{ 'Ends at' if is_en else 'تاريخ الانتهاء' }}</span><b>{% if subscription_day_info.target %}{{ format_local(subscription_day_info.target) }}{% else %}—{% endif %}</b></div>
        <div><span>{{ 'Tenant status' if is_en else 'حالة المشترك' }}</span><b>{{ ui_label(tenant.status, 'status', ui_lang) }}</b></div>
      </div>
    </section>

    <section class="prof-side-card prof-side-quick">
      <header><span class="prof-side-eyebrow">{{ 'Quick actions' if is_en else 'إجراءات سريعة' }}</span></header>
      <div class="prof-side-actions">
        <a class="prof-side-btn act-subscription" href="{{ url_for('main.admin_user_profile', user_id=user_obj.id, lang=ui_lang, tab='subscription') }}">📅 <span>{{ 'Manage subscription' if is_en else 'إدارة الاشتراك' }}</span></a>
        <a class="prof-side-btn act-support" href="{{ url_for('main.admin_user_profile', user_id=user_obj.id, lang=ui_lang, tab='support') }}">💬 <span>{{ 'Open support' if is_en else 'مساحة الدعم' }}</span></a>
        <a class="prof-side-btn act-devices" href="{{ url_for('main.admin_user_profile', user_id=user_obj.id, lang=ui_lang, tab='devices') }}">⚡ <span>{{ 'Devices' if is_en else 'الأجهزة' }}</span></a>
        <a class="prof-side-btn act-finance" href="{{ url_for('main.admin_user_profile', user_id=user_obj.id, lang=ui_lang, tab='finance') }}">💰 <span>{{ 'Finance' if is_en else 'المالية' }}</span></a>
      </div>
    </section>

    <section class="prof-side-card prof-side-meta">
      <header><span class="prof-side-eyebrow">{{ 'Account meta' if is_en else 'معلومات الحساب' }}</span></header>
      <div class="prof-side-rows">
        <div><span>{{ 'User ID' if is_en else 'المعرّف' }}</span><b>#{{ user_obj.id }}</b></div>
        <div><span>{{ 'Created' if is_en else 'تاريخ الإنشاء' }}</span><b>{% if user_obj.created_at %}{{ format_local(user_obj.created_at) }}{% else %}—{% endif %}</b></div>
        <div><span>{{ 'Last login' if is_en else 'آخر دخول' }}</span><b>{% if user_obj.last_login_at %}{{ format_local(user_obj.last_login_at) }}{% else %}—{% endif %}</b></div>
      </div>
    </section>
  </aside>
  </div>
</div>{# /.prof-shell #}

</div>
<div class="up-pane" data-up-pane="subscription" {% if tab != 'subscription' %}hidden{% endif %}>
<div class="prof-shell">
  {% set current_plan = plans|selectattr('id','equalto', tenant.plan_id)|first %}
  {% set days_left = subscription_day_info.days_left if subscription_day_info.days_left is not none else None %}
  {% set days_pct = ((days_left / 365 * 100) if (days_left is not none and days_left >= 0) else 0)|round(0,'floor')|int %}
  {% set is_expired = subscription_day_info.status == 'expired' %}

  {# ─── Subscription summary card with days ring ─── #}
  <section class="sub-summary">
    <div class="sub-summary-text">
      <span class="sub-summary-eyebrow">📅 {{ 'Active subscription' if is_en else 'الاشتراك الحالي' }}</span>
      <h2>{{ (current_plan.name_en if is_en else current_plan.name_ar) if current_plan else ('No plan' if is_en else 'بدون خطة') }}</h2>
      <div class="sub-summary-tags">
        <span class="sub-tag {{ 'is-active' if subscription and subscription.status in ['active','trial'] else 'is-warn' if subscription and subscription.status=='cancelled' else 'is-danger' }}">{{ ui_label(subscription.status, 'status', ui_lang) if subscription else ('—' if is_en else '—') }}</span>
        <span class="sub-tag {{ 'is-active' if tenant.status == 'active' else 'is-warn' if tenant.status in ['trial','suspended'] else 'is-danger' }}">{{ 'Account: ' if is_en else 'الحساب: ' }}{{ ui_label(tenant.status, 'status', ui_lang) }}</span>
        {% if tenant.max_devices_override %}<span class="sub-tag is-info">{{ 'Override: ' if is_en else 'تجاوز: ' }}{{ tenant.max_devices_override }} {{ 'devices' if is_en else 'جهاز' }}</span>{% endif %}
      </div>
      <div class="sub-summary-rows">
        <div><small>{{ 'Starts' if is_en else 'تاريخ البداية' }}</small><strong>{% if subscription and subscription.starts_at %}{{ format_local(subscription.starts_at) }}{% else %}—{% endif %}</strong></div>
        <div><small>{{ 'Ends' if is_en else 'تاريخ الانتهاء' }}</small><strong>{% if subscription and subscription.ends_at %}{{ format_local(subscription.ends_at) }}{% else %}—{% endif %}</strong></div>
        <div><small>{{ 'Trial ends' if is_en else 'نهاية التجربة' }}</small><strong>{% if subscription and subscription.trial_ends_at %}{{ format_local(subscription.trial_ends_at) }}{% else %}—{% endif %}</strong></div>
      </div>
    </div>
    <div class="sub-summary-ring {{ 'is-expired' if is_expired }}" style="--pct:{{ days_pct if days_pct <= 100 else 100 }}">
      <div class="sub-summary-ring-inner">
        <span class="sub-summary-ring-num">{% if days_left is not none %}{{ days_left }}{% else %}—{% endif %}</span>
        <span class="sub-summary-ring-lbl">{{ 'days left' if is_en else 'يوم متبقي' }}</span>
      </div>
    </div>
  </section>

  <div class="prof-grid">
    <div>
      {# ─── Step 1: Plan & lifecycle ─── #}
      <form method="post" class="prof-form" id="sub-plan-form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="action" value="save_subscription">

        <article class="prof-step">
          <div class="prof-step-side">
            <span class="prof-step-num">1</span>
            <span class="prof-step-icon">📋</span>
            <small>{{ 'Step 1' if is_en else 'الخطوة 1' }}</small>
            <h3>{{ 'Plan & lifecycle' if is_en else 'الخطة ودورة الحياة' }}</h3>
            <p>{{ 'Pick a plan and adjust dates. Saving here applies the new plan quotas automatically.' if is_en else 'اختر الخطة واضبط التواريخ. الحفظ يطبق كوتا الخطة الجديدة تلقائياً.' }}</p>
          </div>
          <div class="prof-step-body">
            <label class="prof-field prof-field-full">
              <span>{{ 'Plan' if is_en else 'الخطة' }}</span>
              <select class="prof-input" name="plan_id">{% for plan in plans %}<option value="{{ plan.id }}" {% if tenant.plan_id==plan.id %}selected{% endif %}>{{ plan.name_en if is_en else plan.name_ar }}</option>{% endfor %}</select>
            </label>
            <label class="prof-field">
              <span>{{ 'Account status' if is_en else 'حالة الحساب' }}</span>
              <select class="prof-input" name="tenant_status">{% for st in ['trial','active','suspended','expired'] %}<option value="{{ st }}" {% if tenant.status==st %}selected{% endif %}>{{ ui_label(st, 'status', ui_lang) }}</option>{% endfor %}</select>
            </label>
            <label class="prof-field">
              <span>{{ 'Subscription status' if is_en else 'حالة الاشتراك' }}</span>
              <select class="prof-input" name="subscription_status">{% for st in ['trial','active','cancelled','expired'] %}<option value="{{ st }}" {% if subscription and subscription.status==st %}selected{% endif %}>{{ ui_label(st, 'status', ui_lang) }}</option>{% endfor %}</select>
            </label>
            <label class="prof-field">
              <span>{{ 'Start date' if is_en else 'تاريخ البداية' }}</span>
              <input type="date" class="prof-input" name="starts_at" value="{{ subscription.starts_at.strftime('%Y-%m-%d') if subscription and subscription.starts_at else '' }}">
            </label>
            <label class="prof-field">
              <span>{{ 'End date' if is_en else 'تاريخ الانتهاء' }}</span>
              <input type="date" class="prof-input" name="ends_at" id="sub-end-date" value="{{ subscription.ends_at.strftime('%Y-%m-%d') if subscription and subscription.ends_at else '' }}">
            </label>
            <label class="prof-field">
              <span>{{ 'Trial end' if is_en else 'نهاية التجربة' }}</span>
              <input type="date" class="prof-input" name="trial_ends_at" value="{{ subscription.trial_ends_at.strftime('%Y-%m-%d') if subscription and subscription.trial_ends_at else '' }}">
            </label>
            <label class="prof-field">
              <span>{{ 'Device limit override' if is_en else 'حد الأجهزة (تجاوز)' }}</span>
              <input class="prof-input" type="number" min="0" name="max_devices_override" value="{{ tenant.max_devices_override or '' }}" placeholder="{{ 'Leave blank for plan default' if is_en else 'فارغ = الحد الافتراضي للخطة' }}">
            </label>
            <label class="prof-field prof-field-full">
              <span>{{ 'Notes' if is_en else 'ملاحظات' }}</span>
              <textarea class="prof-input" name="subscription_notes" rows="3" placeholder="{{ 'Internal notes (admin only)' if is_en else 'ملاحظات داخلية (للمسؤول فقط)' }}">{{ subscription.notes if subscription and subscription.notes else '' }}</textarea>
            </label>
          </div>
        </article>

        <div class="prof-savebar">
          <span class="prof-savebar-hint">💡 {{ 'Saving applies plan quotas automatically.' if is_en else 'الحفظ يطبق كوتا الخطة الجديدة تلقائياً.' }}</span>
          <div class="prof-savebar-actions">
            <button class="prof-btn prof-btn-primary" type="submit">💾 {{ 'Save subscription' if is_en else 'حفظ الاشتراك' }}</button>
          </div>
        </div>
      </form>

      {# ─── Step 2: Page visibility ─── #}
      <form method="post" class="prof-form" id="sub-pages-form" style="margin-top:18px">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="action" value="portal_visibility">

        <article class="prof-step">
          <div class="prof-step-side">
            <span class="prof-step-num">2</span>
            <span class="prof-step-icon">👁️</span>
            <small>{{ 'Step 2' if is_en else 'الخطوة 2' }}</small>
            <h3>{{ 'Page visibility' if is_en else 'ظهور الصفحات' }}</h3>
            <p>{{ 'Pick which pages this subscriber can see. The dashboard is always visible.' if is_en else 'اختر الصفحات التي يراها هذا المشترك. النظرة العامة دائماً ظاهرة.' }}</p>
          </div>
          <div class="prof-step-body sub-pages">
            {% for page in portal_page_rows %}
              <label class="sub-page-card {% if page.is_locked %}is-locked{% endif %} {% if page.is_visible or page.is_locked %}is-on{% endif %}">
                <input type="checkbox" name="visible_pages" value="{{ page.page_key }}" {% if page.is_visible or page.is_locked %}checked{% endif %} {% if page.is_locked %}disabled{% endif %}>
                <span class="sub-page-icon">{{ page.icon }}</span>
                <span class="sub-page-label">{{ page.label }}</span>
                {% if page.is_locked %}<span class="sub-page-lock">🔒 {{ 'Core' if is_en else 'أساسية' }}</span>{% endif %}
              </label>
            {% endfor %}
          </div>
        </article>

        <div class="prof-savebar">
          <span class="prof-savebar-hint">💡 {{ 'Hidden pages disappear from the subscriber sidebar.' if is_en else 'الصفحات المخفية تختفي من قائمة المشترك.' }}</span>
          <div class="prof-savebar-actions">
            <button class="prof-btn prof-btn-primary" type="submit">💾 {{ 'Save visibility' if is_en else 'حفظ الظهور' }}</button>
          </div>
        </div>
      </form>
    </div>

    {# ─── Side column ─── #}
    <aside class="prof-side">
      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Quick lifecycle' if is_en else 'أزرار سريعة' }}</span></header>
        <div class="prof-side-actions">
          <button type="button" class="prof-side-btn act-subscription" data-extend-days="30">⏰ <span>{{ 'Extend +30 days' if is_en else 'تمديد +30 يوم' }}</span></button>
          <button type="button" class="prof-side-btn act-subscription" data-extend-days="90">⏰ <span>{{ 'Extend +90 days' if is_en else 'تمديد +90 يوم' }}</span></button>
          <button type="button" class="prof-side-btn act-finance" data-extend-days="365">⏰ <span>{{ 'Extend +1 year' if is_en else 'تمديد +سنة' }}</span></button>
        </div>
        <small class="sub-side-hint">{{ 'Updates the End date field. Press save to commit.' if is_en else 'يحدّث حقل تاريخ الانتهاء. اضغط حفظ لتطبيق التغيير.' }}</small>
      </section>

      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Plan summary' if is_en else 'ملخص الخطة' }}</span></header>
        <div class="prof-side-rows">
          <div><span>{{ 'Plan' if is_en else 'الخطة' }}</span><b>{{ (current_plan.name_en if is_en else current_plan.name_ar) if current_plan else '—' }}</b></div>
          <div><span>{{ 'Devices' if is_en else 'الأجهزة' }}</span><b>{{ devices|length }}{% if tenant.max_devices_override %} / {{ tenant.max_devices_override }}{% elif current_plan and current_plan.max_devices %} / {{ current_plan.max_devices }}{% endif %}</b></div>
          <div><span>{{ 'Days left' if is_en else 'الأيام المتبقية' }}</span><b>{% if days_left is not none %}{{ days_left }}{% else %}—{% endif %}</b></div>
          <div><span>{{ 'Wallet' if is_en else 'المحفظة' }}</span><b>{{ '%.2f'|format(wallet_balance or 0) }}</b></div>
        </div>
      </section>
    </aside>
  </div>
</div>{# /.prof-shell #}
</div>
<div class="up-pane" data-up-pane="support" {% if tab != 'support' %}hidden{% endif %}>
<div class="prof-shell">
  {% set _open_threads = thread_rows|rejectattr('thread.status','in',['closed','resolved'])|list %}
  {% set _closed_threads = thread_rows|selectattr('thread.status','in',['closed','resolved'])|list %}
  {% set _open_tickets = ticket_rows|rejectattr('ticket.status','in',['closed','resolved'])|list %}
  {% set _closed_tickets = ticket_rows|selectattr('ticket.status','in',['closed','resolved'])|list %}
  {% set _total_open = _open_threads|length + _open_tickets|length %}
  {% set _total_closed = _closed_threads|length + _closed_tickets|length %}
  {% set _total = _total_open + _total_closed %}

  {# ─── Compact hero ─── #}
  <section class="md-hero">
    <div class="md-hero-text">
      <span class="md-hero-eyebrow">💬 {{ 'Support' if is_en else 'الدعم' }}</span>
      <h2>{{ 'Triage and reply, one conversation at a time.' if is_en else 'فرز ورد، محادثة واحدة في نفس الوقت.' }}</h2>
    </div>
    <div class="md-hero-pills">
      <span class="md-pill md-pill-total">📨 {{ _total }} {{ 'total' if is_en else 'إجمالي' }}</span>
      <span class="md-pill md-pill-open">🔥 {{ _total_open }} {{ 'open' if is_en else 'مفتوح' }}</span>
      <span class="md-pill md-pill-closed">🔒 {{ _total_closed }} {{ 'closed' if is_en else 'مغلق' }}</span>
      <a class="md-pill md-pill-link" href="{{ url_for('main.admin_support_command_center', lang=ui_lang, filter='all') }}">🎯 {{ 'Command center' if is_en else 'مركز القيادة' }}</a>
    </div>
  </section>

  {# ─── Master/Detail layout ─── #}
  <div class="md-layout" data-md-layout>
    {# ─── Master: compact list ─── #}
    <aside class="md-list" data-md-list>
      <div class="md-list-tools">
        <input type="search" class="md-search" placeholder="{{ 'Search…' if is_en else 'ابحث…' }}" data-md-search>
        <div class="md-tabs" role="tablist">
          <button type="button" class="md-tab is-on" data-md-tab="open">{{ 'Open' if is_en else 'مفتوح' }} <b>{{ _total_open }}</b></button>
          <button type="button" class="md-tab" data-md-tab="closed">{{ 'Closed' if is_en else 'مغلق' }} <b>{{ _total_closed }}</b></button>
        </div>
      </div>

      <div class="md-list-section" data-md-section="open">
        {% if _total_open == 0 %}
          <div class="md-list-empty">
            <span>📭</span>
            <p>{{ 'No open conversations.' if is_en else 'لا توجد محادثات مفتوحة.' }}</p>
          </div>
        {% endif %}

        {% macro list_thread(row, is_closed) %}
          {% set last_msg = row.messages|last %}
          {% set status_label = labels['status'].get(row.thread.status, row.thread.status) %}
          {% set key = 'thread-' ~ row.thread.id %}
          <button type="button" class="md-row md-row-message status-{{ row.thread.status }} {{ 'is-closed' if is_closed else '' }}"
                  data-md-row data-md-key="{{ key }}"
                  data-md-search-text="{{ (row.thread.subject ~ ' ' ~ (last_msg.body if last_msg else ''))|lower }}">
            <span class="md-row-stripe"></span>
            <span class="md-row-icon">✉️</span>
            <div class="md-row-body">
              <div class="md-row-line1">
                <strong>#{{ row.thread.id }} — {{ row.thread.subject }}</strong>
                <small class="md-row-time">{{ format_local(last_msg.created_at)[:10] if last_msg and last_msg.created_at else '' }}</small>
              </div>
              <div class="md-row-line2">
                <span class="md-row-status">{{ status_label }}</span>
                <span class="md-row-msg-count">{{ row.messages|length }} {{ 'msg' if is_en else 'رسالة' }}</span>
              </div>
            </div>
          </button>
        {% endmacro %}

        {% macro list_ticket(row, is_closed) %}
          {% set last_msg = row.messages|last %}
          {% set status_label = labels['status'].get(row.ticket.status, row.ticket.status) %}
          {% set key = 'ticket-' ~ row.ticket.id %}
          <button type="button" class="md-row md-row-ticket status-{{ row.ticket.status }} {{ 'is-closed' if is_closed else '' }}"
                  data-md-row data-md-key="{{ key }}"
                  data-md-search-text="{{ (row.ticket.subject ~ ' ' ~ (last_msg.body if last_msg else ''))|lower }}">
            <span class="md-row-stripe"></span>
            <span class="md-row-icon">🎫</span>
            <div class="md-row-body">
              <div class="md-row-line1">
                <strong>#{{ row.ticket.id }} — {{ row.ticket.subject }}</strong>
                <small class="md-row-time">{{ format_local(last_msg.created_at)[:10] if last_msg and last_msg.created_at else '' }}</small>
              </div>
              <div class="md-row-line2">
                <span class="md-row-status">{{ status_label }}</span>
                <span class="md-row-msg-count">{{ row.messages|length }} {{ 'msg' if is_en else 'رسالة' }}</span>
              </div>
            </div>
          </button>
        {% endmacro %}

        {% for row in _open_threads %}{{ list_thread(row, false) }}{% endfor %}
        {% for row in _open_tickets %}{{ list_ticket(row, false) }}{% endfor %}
      </div>

      <div class="md-list-section" data-md-section="closed" hidden>
        {% if _total_closed == 0 %}
          <div class="md-list-empty">
            <span>🗄️</span>
            <p>{{ 'No closed items yet.' if is_en else 'لا توجد عناصر مغلقة بعد.' }}</p>
          </div>
        {% endif %}
        {% for row in _closed_threads %}{{ list_thread(row, true) }}{% endfor %}
        {% for row in _closed_tickets %}{{ list_ticket(row, true) }}{% endfor %}
      </div>
    </aside>

    {# ─── Detail: thread + reply ─── #}
    <main class="md-detail" data-md-detail>

      {% macro detail_thread(row, is_closed) %}
        {% set last_msg = row.messages|last %}
        {% set key = 'thread-' ~ row.thread.id %}
        {% set status_label = labels['status'].get(row.thread.status, row.thread.status) %}
        {% set priority_label = labels['priority'].get(row.thread.priority, row.thread.priority) %}
        <article class="md-pane" data-md-pane="{{ key }}" hidden>
          <header class="md-pane-head">
            <div class="md-pane-title">
              <span class="md-pane-title-icon md-pane-title-icon-message">✉️</span>
              <div>
                <h3>#{{ row.thread.id }} — {{ row.thread.subject }}</h3>
                <small>{{ row.thread.category or ('Conversation' if is_en else 'محادثة') }}</small>
              </div>
            </div>
            <div class="md-pane-pills">
              <span class="md-detail-pill status-{{ row.thread.status }}">{{ status_label }}</span>
              <span class="md-detail-pill priority-{{ row.thread.priority }}">{{ priority_label }}</span>
              {% if row.assignee %}<span class="md-detail-pill assignee">🧑‍💼 {{ row.assignee.full_name or row.assignee.username }}</span>{% endif %}
            </div>
          </header>

          <div class="md-thread">
            {% for msg in row.messages %}
              {% set is_admin = msg.sender_scope == 'admin' %}
              <div class="md-msg {{ 'md-msg-admin' if is_admin else 'md-msg-user' }} {{ 'md-msg-internal' if msg.is_internal_note else '' }}">
                <div class="md-msg-avatar">
                  {% if msg.is_internal_note %}🔒
                  {% elif is_admin %}🛡️
                  {% else %}{{ (user_obj.full_name or user_obj.username or 'U')[:1]|upper }}{% endif %}
                </div>
                <div class="md-msg-body">
                  <div class="md-msg-meta">
                    <strong>{% if msg.is_internal_note %}{{ 'Internal note' if is_en else 'ملاحظة داخلية' }}
                    {% elif is_admin %}{{ 'Admin' if is_en else 'الإدارة' }}
                    {% else %}{{ user_obj.full_name or user_obj.username }}{% endif %}</strong>
                    <time>{{ format_local(msg.created_at) if msg.created_at else '' }}</time>
                  </div>
                  <p class="md-msg-text">{{ msg.body }}</p>
                </div>
              </div>
            {% else %}
              <div class="md-thread-empty">{{ 'No messages yet.' if is_en else 'لا توجد رسائل بعد.' }}</div>
            {% endfor %}
          </div>

          {% if not is_closed %}
          <form method="post" action="{{ url_for('main.admin_user_profile', user_id=user_obj.id, lang=ui_lang, tab='support') }}#{{ key }}" class="md-reply" data-support-reply-form data-case-key="{{ 'mail-' ~ row.thread.id }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="action" value="mail_reply">
            <input type="hidden" name="thread_id" value="{{ row.thread.id }}">
            <div class="md-reply-toolbar">
              <label class="md-reply-field">
                <span>{{ 'Status' if is_en else 'الحالة' }}</span>
                <select class="prof-input md-reply-select" name="status" data-status-select>
                  {% for st in status_options %}<option value="{{ st }}" {% if row.thread.status==st %}selected{% endif %}>{{ labels['status'].get(st, st) }}</option>{% endfor %}
                </select>
              </label>
              <label class="md-reply-field">
                <span>{{ 'Manager' if is_en else 'المدير' }}</span>
                <select class="prof-input md-reply-select" name="assigned_admin_user_id">
                  <option value="">{{ 'Unassigned' if is_en else 'بدون مدير' }}</option>
                  {% for admin in admin_users %}<option value="{{ admin.id }}" {% if row.assignee and row.assignee.id==admin.id %}selected{% endif %}>{{ admin.full_name or admin.username }}</option>{% endfor %}
                </select>
              </label>
              <label class="md-reply-field md-reply-field-toggle">
                <span>{{ 'Type' if is_en else 'النوع' }}</span>
                <span class="md-reply-toggle">
                  <input type="checkbox" name="is_internal_note" value="1">
                  <em>🔒 {{ 'Internal' if is_en else 'داخلية' }}</em>
                </span>
              </label>
            </div>
            <textarea class="prof-input md-reply-text" name="body" rows="3" data-reply-textarea placeholder="{{ 'Write a reply…' if is_en else 'اكتب رداً…' }}"></textarea>
            <div class="md-reply-actions">
              <span class="canned-anchor">
                <button type="button" class="prof-btn prof-btn-ghost" data-canned-toggle>⚡ {{ 'Canned' if is_en else 'جاهزة' }}</button>
                {% include '_support_canned_drawer_v62.html' %}
              </span>
              <button class="prof-btn prof-btn-ghost" type="submit" name="assignment_only" value="1">{{ 'Assign only' if is_en else 'تعيين' }}</button>
              <button class="prof-btn prof-btn-primary" type="submit" data-default-submit>📤 {{ 'Send' if is_en else 'إرسال' }}</button>
            </div>
          </form>
          {% else %}
          <div class="md-frozen">🔒 {{ 'This conversation is closed. Reopen from command center to continue.' if is_en else 'المحادثة مغلقة. أعد فتحها من مركز القيادة للمتابعة.' }}</div>
          {% endif %}
        </article>
      {% endmacro %}

      {% macro detail_ticket(row, is_closed) %}
        {% set last_msg = row.messages|last %}
        {% set key = 'ticket-' ~ row.ticket.id %}
        {% set status_label = labels['status'].get(row.ticket.status, row.ticket.status) %}
        {% set priority_label = labels['priority'].get(row.ticket.priority, row.ticket.priority) %}
        <article class="md-pane" data-md-pane="{{ key }}" hidden>
          <header class="md-pane-head">
            <div class="md-pane-title">
              <span class="md-pane-title-icon md-pane-title-icon-ticket">🎫</span>
              <div>
                <h3>#{{ row.ticket.id }} — {{ row.ticket.subject }}</h3>
                <small>{{ row.ticket.category or ('Ticket' if is_en else 'تذكرة') }}{% if row.device %} · ⚡ {{ row.device.name }}{% endif %}</small>
              </div>
            </div>
            <div class="md-pane-pills">
              <span class="md-detail-pill status-{{ row.ticket.status }}">{{ status_label }}</span>
              <span class="md-detail-pill priority-{{ row.ticket.priority }}">{{ priority_label }}</span>
              {% if row.assignee %}<span class="md-detail-pill assignee">🧑‍💼 {{ row.assignee.full_name or row.assignee.username }}</span>{% endif %}
            </div>
          </header>

          <div class="md-thread">
            {% for msg in row.messages %}
              {% set is_admin = msg.sender_scope == 'admin' %}
              <div class="md-msg {{ 'md-msg-admin' if is_admin else 'md-msg-user' }} {{ 'md-msg-internal' if msg.is_internal_note else '' }}">
                <div class="md-msg-avatar">
                  {% if msg.is_internal_note %}🔒
                  {% elif is_admin %}🛡️
                  {% else %}{{ (user_obj.full_name or user_obj.username or 'U')[:1]|upper }}{% endif %}
                </div>
                <div class="md-msg-body">
                  <div class="md-msg-meta">
                    <strong>{% if msg.is_internal_note %}{{ 'Internal note' if is_en else 'ملاحظة داخلية' }}
                    {% elif is_admin %}{{ 'Admin' if is_en else 'الإدارة' }}
                    {% else %}{{ user_obj.full_name or user_obj.username }}{% endif %}</strong>
                    <time>{{ format_local(msg.created_at) if msg.created_at else '' }}</time>
                  </div>
                  <p class="md-msg-text">{{ msg.body }}</p>
                </div>
              </div>
            {% else %}
              <div class="md-thread-empty">{{ 'No messages yet.' if is_en else 'لا توجد رسائل بعد.' }}</div>
            {% endfor %}
          </div>

          {% if not is_closed %}
          <form method="post" action="{{ url_for('main.admin_user_profile', user_id=user_obj.id, lang=ui_lang, tab='support') }}#{{ key }}" class="md-reply" data-support-reply-form data-case-key="{{ 'ticket-' ~ row.ticket.id }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="action" value="ticket_reply">
            <input type="hidden" name="ticket_id" value="{{ row.ticket.id }}">
            <div class="md-reply-toolbar">
              <label class="md-reply-field">
                <span>{{ 'Status' if is_en else 'الحالة' }}</span>
                <select class="prof-input md-reply-select" name="status" data-status-select>
                  {% for st in status_options %}<option value="{{ st }}" {% if row.ticket.status==st %}selected{% endif %}>{{ labels['status'].get(st, st) }}</option>{% endfor %}
                </select>
              </label>
              <label class="md-reply-field">
                <span>{{ 'Manager' if is_en else 'المدير' }}</span>
                <select class="prof-input md-reply-select" name="assigned_admin_user_id">
                  <option value="">{{ 'Unassigned' if is_en else 'بدون مدير' }}</option>
                  {% for admin in admin_users %}<option value="{{ admin.id }}" {% if row.assignee and row.assignee.id==admin.id %}selected{% endif %}>{{ admin.full_name or admin.username }}</option>{% endfor %}
                </select>
              </label>
              <label class="md-reply-field md-reply-field-toggle">
                <span>{{ 'Type' if is_en else 'النوع' }}</span>
                <span class="md-reply-toggle">
                  <input type="checkbox" name="is_internal_note" value="1">
                  <em>🔒 {{ 'Internal' if is_en else 'داخلية' }}</em>
                </span>
              </label>
            </div>
            <textarea class="prof-input md-reply-text" name="body" rows="3" data-reply-textarea placeholder="{{ 'Reply to the ticket…' if is_en else 'اكتب رداً على التذكرة…' }}"></textarea>
            <div class="md-reply-actions">
              <span class="canned-anchor">
                <button type="button" class="prof-btn prof-btn-ghost" data-canned-toggle>⚡ {{ 'Canned' if is_en else 'جاهزة' }}</button>
                {% include '_support_canned_drawer_v62.html' %}
              </span>
              <button class="prof-btn prof-btn-ghost" type="submit" name="assignment_only" value="1">{{ 'Assign only' if is_en else 'تعيين' }}</button>
              <button class="prof-btn prof-btn-primary" type="submit" data-default-submit>📤 {{ 'Send' if is_en else 'إرسال' }}</button>
            </div>
          </form>
          {% else %}
          <div class="md-frozen">🔒 {{ 'This ticket is closed. Reopen from command center to continue.' if is_en else 'التذكرة مغلقة. أعد فتحها من مركز القيادة للمتابعة.' }}</div>
          {% endif %}
        </article>
      {% endmacro %}

      {% for row in _open_threads %}{{ detail_thread(row, false) }}{% endfor %}
      {% for row in _open_tickets %}{{ detail_ticket(row, false) }}{% endfor %}
      {% for row in _closed_threads %}{{ detail_thread(row, true) }}{% endfor %}
      {% for row in _closed_tickets %}{{ detail_ticket(row, true) }}{% endfor %}

      <div class="md-empty" data-md-empty>
        <span>👋</span>
        <strong>{{ 'Pick a conversation' if is_en else 'اختر محادثة' }}</strong>
        <small>{{ 'Click any item from the list to read and reply.' if is_en else 'اضغط أي عنصر من القائمة لقراءة الثريد والرد.' }}</small>
      </div>
    </main>
  </div>
</div>{# /.prof-shell #}

<script>
window.SolarSupportInit = function(preserveKey){
  const pane = document.querySelector('[data-up-pane="support"]');
  if(!pane) return;
  const layout = pane.querySelector('[data-md-layout]');
  if(!layout) return;
  const list = layout.querySelector('[data-md-list]');
  const detail = layout.querySelector('[data-md-detail]');
  const empty = detail.querySelector('[data-md-empty]');
  const rows = layout.querySelectorAll('[data-md-row]');
  const panes = detail.querySelectorAll('[data-md-pane]');
  const sections = list.querySelectorAll('[data-md-section]');
  const tabs = list.querySelectorAll('[data-md-tab]');
  const search = list.querySelector('[data-md-search]');

  function activate(key){
    rows.forEach(function(r){ r.classList.toggle('is-active', r.dataset.mdKey === key); });
    panes.forEach(function(p){
      if(p.dataset.mdPane === key){ p.removeAttribute('hidden'); }
      else { p.setAttribute('hidden',''); }
    });
    if(empty) empty.style.display = key ? 'none' : '';
    const target = detail.querySelector('[data-md-pane="' + key + '"]');
    if(target){
      const thread = target.querySelector('.md-thread');
      if(thread) thread.scrollTop = thread.scrollHeight;
    }
  }

  rows.forEach(function(r){ r.addEventListener('click', function(){ activate(r.dataset.mdKey); }); });

  tabs.forEach(function(t){
    t.addEventListener('click', function(){
      tabs.forEach(function(x){ x.classList.remove('is-on'); });
      t.classList.add('is-on');
      const target = t.dataset.mdTab;
      sections.forEach(function(s){
        if(s.dataset.mdSection === target) s.removeAttribute('hidden');
        else s.setAttribute('hidden','');
      });
    });
  });

  if(search){
    search.addEventListener('input', function(){
      const q = (search.value || '').trim().toLowerCase();
      rows.forEach(function(r){
        const txt = r.dataset.mdSearchText || '';
        r.style.display = (!q || txt.indexOf(q) !== -1) ? '' : 'none';
      });
    });
  }

  // Reliable submit: regular form POST (page reloads). Show "saving" briefly so user sees feedback.
  pane.querySelectorAll('form[data-support-reply-form]').forEach(function(form){
    form.addEventListener('submit', function(ev){
      // Strip URL fragment from action attribute so the POST goes to a clean URL.
      // NOTE: form.action returns the <input name="action"> element due to property shadowing,
      // so we must use getAttribute/setAttribute to read/write the actual action attribute.
      try{
        const rawAction = form.getAttribute('action') || window.location.href;
        const cleanAction = rawAction.split('#')[0];
        if(cleanAction !== rawAction){ form.setAttribute('action', cleanAction); }
      }catch(_){}
      // Close any open canned popover so it does not flash during reload
      const openDrawer = form.querySelector('[data-canned-drawer]:not([hidden])');
      if(openDrawer) openDrawer.hidden = true;
      // Lock submitter button briefly so user gets feedback
      const submitBtn = ev.submitter || form.querySelector('button[type="submit"][data-default-submit]');
      if(submitBtn){
        submitBtn.disabled = true;
        submitBtn.innerHTML = '⏳ ' + (document.documentElement.lang === 'en' ? 'Sending…' : 'جاري الحفظ…');
      }
      // Form submits normally. Page reloads to the support tab via the redirect after save.
    });
  });

  // After clicking a canned reply: insert text, focus textarea, close the popover (clear UX)
  pane.querySelectorAll('[data-canned-card][data-canned-action]').forEach(function(item){
    item.addEventListener('click', function(){
      const drawer = item.closest('[data-canned-drawer]');
      // Small delay so the global app.js handler can insert the text first
      setTimeout(function(){ if(drawer) drawer.hidden = true; }, 50);
    });
  });

  // Pick which row to activate
  let key = preserveKey || null;
  if(!key){
    const first = layout.querySelector('[data-md-row]:not(.is-closed)') || layout.querySelector('[data-md-row]');
    key = first ? first.dataset.mdKey : null;
  }
  if(key) activate(key);
};
window.SolarSupportInit();
</script>
</div>
<div class="up-pane" data-up-pane="finance" {% if tab != 'finance' %}hidden{% endif %}>
<div class="prof-shell">
  {% set credits = finance_rows|selectattr('entry_type','equalto','credit')|list %}
  {% set debits  = finance_rows|selectattr('entry_type','equalto','debit')|list %}
  {% set total_credit = (credits|sum(attribute='amount')) or 0 %}
  {% set total_debit  = (debits|sum(attribute='amount')) or 0 %}
  {% set total = total_credit + total_debit %}
  {% set credit_pct = ((total_credit / total * 100) if total > 0 else 0)|round(0)|int %}

  {# ─── Wallet hero ─── #}
  <section class="fin-hero">
    <div class="fin-hero-text">
      <span class="fin-hero-eyebrow">💰 {{ 'Wallet' if is_en else 'المحفظة' }}</span>
      <h2 class="fin-balance {{ 'is-negative' if (wallet_balance or 0) < 0 }}">{{ '%.2f'|format(wallet_balance or 0) }} <small>USD</small></h2>
      <p>{{ 'Track credits with payment method, debits with reason — all in one ledger.' if is_en else 'سجّل الإضافات بطريقة الدفع، والخصومات بسبب الخدمة — كل ذلك في سجل موحَّد.' }}</p>
      <div class="fin-hero-stats">
        <div class="fin-mini fin-mini-credit"><span>↑</span><div><small>{{ 'Total credits' if is_en else 'إجمالي الإضافات' }}</small><strong>{{ '%.2f'|format(total_credit) }}</strong></div></div>
        <div class="fin-mini fin-mini-debit"><span>↓</span><div><small>{{ 'Total debits' if is_en else 'إجمالي الخصومات' }}</small><strong>{{ '%.2f'|format(total_debit) }}</strong></div></div>
        <div class="fin-mini fin-mini-count"><span>📒</span><div><small>{{ 'Movements' if is_en else 'الحركات' }}</small><strong>{{ finance_rows|length }}</strong></div></div>
      </div>
    </div>
    <div class="fin-hero-ring" style="--pct:{{ credit_pct }}">
      <div class="fin-hero-ring-inner">
        <span class="fin-hero-ring-num">{{ credit_pct }}%</span>
        <span class="fin-hero-ring-lbl">{{ 'credits' if is_en else 'إضافات' }}</span>
      </div>
    </div>
  </section>

  <div class="prof-grid">
    <div>
      {# ─── Step 1: Add movement (smart form) ─── #}
      <form method="post" class="prof-form" data-fin-form>
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="action" value="finance_entry">
        <input type="hidden" name="payment_method" id="fin-method" value="cash">
        <input type="hidden" name="debit_reason" id="fin-reason" value="renew_sub">
        <input type="hidden" name="reason_meta" id="fin-reason-meta" value="">

        <article class="prof-step">
          <div class="prof-step-side">
            <span class="prof-step-num">1</span>
            <span class="prof-step-icon">💳</span>
            <small>{{ 'Step 1' if is_en else 'الخطوة 1' }}</small>
            <h3>{{ 'Add movement' if is_en else 'إضافة حركة مالية' }}</h3>
            <p>{{ 'Pick credit or debit. Each shows the right options.' if is_en else 'اختر إضافة أو خصم — كل واحد بظهر له الخيارات المناسبة.' }}</p>
          </div>
          <div class="prof-step-body fin-form-body">

            {# Quick preset chips — full-width strip #}
            <div class="fin-quick prof-field-full">
              <button type="button" class="fin-quick-btn fin-quick-credit" data-fin-set='{"type":"credit","amount":10}'>+10</button>
              <button type="button" class="fin-quick-btn fin-quick-credit" data-fin-set='{"type":"credit","amount":50}'>+50</button>
              <button type="button" class="fin-quick-btn fin-quick-credit" data-fin-set='{"type":"credit","amount":100}'>+100</button>
              <button type="button" class="fin-quick-btn fin-quick-debit" data-fin-set='{"type":"debit","amount":10}'>−10</button>
              <button type="button" class="fin-quick-btn fin-quick-debit" data-fin-set='{"type":"debit","amount":50}'>−50</button>
              <button type="button" class="fin-quick-btn fin-quick-debit" data-fin-set='{"type":"debit","amount":100}'>−100</button>
            </div>

            {# Type, amount, currency — three fields in a row #}
            <label class="prof-field">
              <span>{{ 'Type' if is_en else 'نوع الحركة' }}</span>
              <select class="prof-input" name="entry_type" id="fin-type" data-fin-type>
                <option value="credit">↑ {{ 'Credit (add)' if is_en else 'إضافة رصيد' }}</option>
                <option value="debit">↓ {{ 'Debit (deduct)' if is_en else 'خصم رصيد' }}</option>
              </select>
            </label>
            <label class="prof-field">
              <span>{{ 'Amount' if is_en else 'المبلغ' }} <em>*</em></span>
              <input class="prof-input" type="number" min="0" step="0.01" name="amount" id="fin-amount" required placeholder="0.00">
            </label>
            <label class="prof-field">
              <span>{{ 'Currency' if is_en else 'العملة' }}</span>
              <select class="prof-input" name="currency">
                <option value="USD">USD — {{ 'US Dollar' if is_en else 'دولار أمريكي' }}</option>
                <option value="EUR">EUR — {{ 'Euro' if is_en else 'يورو' }}</option>
                <option value="ILS">ILS — {{ 'Shekel' if is_en else 'شيقل' }}</option>
                <option value="JOD">JOD — {{ 'Jordanian Dinar' if is_en else 'دينار أردني' }}</option>
                <option value="SAR">SAR — {{ 'Saudi Riyal' if is_en else 'ريال سعودي' }}</option>
                <option value="AED">AED — {{ 'UAE Dirham' if is_en else 'درهم إماراتي' }}</option>
                <option value="EGP">EGP — {{ 'Egyptian Pound' if is_en else 'جنيه مصري' }}</option>
              </select>
            </label>

            {# ═══ CREDIT VIEW: Payment method cards ═══ #}
            <div class="prof-field prof-field-full" data-fin-credit-section>
              <span>{{ 'Payment method' if is_en else 'طريقة الدفع' }} <em>*</em></span>
              <div class="fin-cards" role="radiogroup">
                <button type="button" class="fin-card is-on" data-method="cash" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#10b981,#34d399)">💵</span>
                  <strong>{{ 'Cash' if is_en else 'نقدي' }}</strong>
                  <small>{{ 'On hand' if is_en else 'مباشر' }}</small>
                </button>
                <button type="button" class="fin-card" data-method="card" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#2563eb,#60a5fa)">💳</span>
                  <strong>{{ 'Card' if is_en else 'بطاقة' }}</strong>
                  <small>{{ 'Visa / MC' if is_en else 'فيزا / ماستر' }}</small>
                </button>
                <button type="button" class="fin-card" data-method="bank" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#7c3aed,#a78bfa)">🏦</span>
                  <strong>{{ 'Bank' if is_en else 'حوالة بنكية' }}</strong>
                  <small>IBAN</small>
                </button>
                <button type="button" class="fin-card" data-method="paypal" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#003087,#0070ba)">🅿️</span>
                  <strong>PayPal</strong>
                  <small>{{ 'Online' if is_en else 'أونلاين' }}</small>
                </button>
                <button type="button" class="fin-card" data-method="usdt" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#26a17b,#50af95)">₮</span>
                  <strong>USDT</strong>
                  <small>{{ 'Crypto' if is_en else 'كريبتو' }}</small>
                </button>
                <button type="button" class="fin-card" data-method="other" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#64748b,#94a3b8)">⚙️</span>
                  <strong>{{ 'Other' if is_en else 'أخرى' }}</strong>
                  <small>{{ 'Custom' if is_en else 'مخصصة' }}</small>
                </button>
              </div>
            </div>

            {# ═══ DEBIT VIEW: Reason cards ═══ #}
            <div class="prof-field prof-field-full" data-fin-debit-section hidden>
              <span>{{ 'Debit reason' if is_en else 'سبب الخصم' }} <em>*</em></span>
              <div class="fin-cards" role="radiogroup">
                <button type="button" class="fin-card is-on" data-reason="renew_sub" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#a78bfa,#7c3aed)">🔄</span>
                  <strong>{{ 'Renew subscription' if is_en else 'تجديد اشتراك' }}</strong>
                  <small>{{ 'Plan period' if is_en else 'فترة الخطة' }}</small>
                </button>
                <button type="button" class="fin-card" data-reason="renew_quota" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#2563eb,#60a5fa)">📊</span>
                  <strong>{{ 'Renew quota' if is_en else 'تجديد كوتة' }}</strong>
                  <small>{{ 'Pick which' if is_en else 'حدد الكوتة' }}</small>
                </button>
                <button type="button" class="fin-card" data-reason="add_device" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#10b981,#34d399)">⚡</span>
                  <strong>{{ 'Add device' if is_en else 'إضافة جهاز' }}</strong>
                  <small>{{ 'Extra device' if is_en else 'جهاز إضافي' }}</small>
                </button>
                <button type="button" class="fin-card" data-reason="refund" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)">💸</span>
                  <strong>{{ 'Refund' if is_en else 'استرداد مبلغ' }}</strong>
                  <small>{{ 'Reverse credit' if is_en else 'إرجاع للعميل' }}</small>
                </button>
                <button type="button" class="fin-card" data-reason="service_fee" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#0891b2,#22d3ee)">🛠️</span>
                  <strong>{{ 'Service fee' if is_en else 'رسوم خدمة' }}</strong>
                  <small>{{ 'Setup / labor' if is_en else 'تركيب / صيانة' }}</small>
                </button>
                <button type="button" class="fin-card" data-reason="sms_topup" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#ec4899,#f472b6)">📱</span>
                  <strong>{{ 'SMS top-up' if is_en else 'شحن SMS' }}</strong>
                  <small>{{ 'Messages bundle' if is_en else 'باقة رسائل' }}</small>
                </button>
                <button type="button" class="fin-card" data-reason="penalty" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#dc2626,#ef4444)">⚠️</span>
                  <strong>{{ 'Penalty' if is_en else 'عقوبة / غرامة' }}</strong>
                  <small>{{ 'Late / abuse' if is_en else 'تأخر / مخالفة' }}</small>
                </button>
                <button type="button" class="fin-card" data-reason="cash_out" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#16a34a,#22c55e)">💰</span>
                  <strong>{{ 'Cash withdrawal' if is_en else 'سحب نقدي' }}</strong>
                  <small>{{ 'Hand-out' if is_en else 'دفع للعميل' }}</small>
                </button>
                <button type="button" class="fin-card" data-reason="other_debit" role="radio">
                  <span class="fin-card-icon" style="background:linear-gradient(135deg,#64748b,#94a3b8)">⚙️</span>
                  <strong>{{ 'Other' if is_en else 'أخرى' }}</strong>
                  <small>{{ 'Custom debit' if is_en else 'خصم مخصص' }}</small>
                </button>
              </div>
            </div>

            {# Sub-selector: which quota — only when reason=renew_quota #}
            <label class="prof-field prof-field-full" data-fin-sub-quota hidden>
              <span>{{ 'Which quota?' if is_en else 'أيّ كوتة؟' }}</span>
              <select class="prof-input" name="quota_target" id="fin-quota-target">
                <option value="sms_limit">📱 SMS</option>
                <option value="devices_limit">⚡ {{ 'Devices' if is_en else 'الأجهزة' }}</option>
                <option value="reports_limit">📊 {{ 'Reports' if is_en else 'التقارير' }}</option>
                <option value="api_calls_limit">🔌 {{ 'API calls' if is_en else 'استدعاءات API' }}</option>
                <option value="storage_limit">💾 {{ 'Storage' if is_en else 'التخزين' }}</option>
                <option value="support_cases_limit">💬 {{ 'Support cases' if is_en else 'تذاكر الدعم' }}</option>
                <option value="telegram_limit">✈️ Telegram</option>
                <option value="custom">⚙️ {{ 'Custom' if is_en else 'مخصصة' }}</option>
              </select>
            </label>

            <label class="prof-field prof-field-full">
              <span>{{ 'Reference / Transaction ID' if is_en else 'المرجع / رقم العملية' }}</span>
              <input class="prof-input" name="reference" id="fin-reference" placeholder="{{ 'e.g. TX-12345 or invoice #' if is_en else 'مثال: TX-12345 أو رقم الفاتورة' }}">
            </label>
            <label class="prof-field prof-field-full">
              <span>{{ 'Note' if is_en else 'ملاحظة' }}</span>
              <textarea class="prof-input" name="note" rows="2" placeholder="{{ 'Optional internal note' if is_en else 'ملاحظة داخلية اختيارية' }}"></textarea>
            </label>
          </div>
        </article>

        <div class="prof-savebar">
          <span class="prof-savebar-hint">💡 {{ 'Saving updates the wallet balance immediately.' if is_en else 'الحفظ يحدّث رصيد المحفظة مباشرة.' }}</span>
          <div class="prof-savebar-actions">
            <button class="prof-btn prof-btn-primary" type="submit">💾 {{ 'Save movement' if is_en else 'حفظ الحركة' }}</button>
          </div>
        </div>
      </form>

      {# ─── Recent ledger ─── #}
      <article class="prof-step" style="margin-top:18px">
        <div class="prof-step-side">
          <span class="prof-step-num">2</span>
          <span class="prof-step-icon">📒</span>
          <small>{{ 'Step 2' if is_en else 'الخطوة 2' }}</small>
          <h3>{{ 'Recent movements' if is_en else 'آخر الحركات' }}</h3>
          <p>{{ 'Each entry shows method (credits) or reason (debits) as a colored chip.' if is_en else 'كل حركة تعرض الطريقة (للإضافة) أو السبب (للخصم) كشارة ملوّنة.' }}</p>
        </div>
        <div class="prof-step-body fin-ledger" style="grid-template-columns:1fr">
          {% set _method_meta = {
            'cash':     {'label_ar':'نقدي', 'label_en':'Cash', 'icon':'💵', 'cls':'method-cash'},
            'card':     {'label_ar':'بطاقة', 'label_en':'Card', 'icon':'💳', 'cls':'method-card'},
            'bank':     {'label_ar':'حوالة', 'label_en':'Bank', 'icon':'🏦', 'cls':'method-bank'},
            'paypal':   {'label_ar':'PayPal', 'label_en':'PayPal', 'icon':'🅿️', 'cls':'method-paypal'},
            'usdt':     {'label_ar':'USDT', 'label_en':'USDT', 'icon':'₮', 'cls':'method-usdt'},
            'other':    {'label_ar':'أخرى', 'label_en':'Other', 'icon':'⚙️', 'cls':'method-other'},
          } %}
          {% set _reason_meta = {
            'renew_sub':    {'label_ar':'تجديد اشتراك', 'label_en':'Renew subscription', 'icon':'🔄', 'cls':'reason-renew-sub'},
            'renew_quota':  {'label_ar':'تجديد كوتة', 'label_en':'Renew quota', 'icon':'📊', 'cls':'reason-renew-quota'},
            'add_device':   {'label_ar':'إضافة جهاز', 'label_en':'Add device', 'icon':'⚡', 'cls':'reason-add-device'},
            'refund':       {'label_ar':'استرداد', 'label_en':'Refund', 'icon':'💸', 'cls':'reason-refund'},
            'service_fee':  {'label_ar':'رسوم خدمة', 'label_en':'Service fee', 'icon':'🛠️', 'cls':'reason-service'},
            'sms_topup':    {'label_ar':'شحن SMS', 'label_en':'SMS top-up', 'icon':'📱', 'cls':'reason-sms'},
            'penalty':      {'label_ar':'غرامة', 'label_en':'Penalty', 'icon':'⚠️', 'cls':'reason-penalty'},
            'cash_out':     {'label_ar':'سحب نقدي', 'label_en':'Cash out', 'icon':'💰', 'cls':'reason-cash-out'},
            'other_debit':  {'label_ar':'أخرى', 'label_en':'Other', 'icon':'⚙️', 'cls':'reason-other'},
          } %}
          {% for entry in finance_rows[:20] %}
            {# Parse [code] from reference #}
            {% set _ref = entry.reference or '' %}
            {% set _code = '' %}
            {% set _real_ref = _ref %}
            {% if _ref.startswith('[') and ']' in _ref %}
              {% set _close = _ref.find(']') %}
              {% set _code = _ref[1:_close] %}
              {% set _real_ref = _ref[_close+1:] %}
            {% endif %}
            {% set _is_credit = entry.entry_type == 'credit' %}
            {% if _is_credit %}
              {% set _meta = _method_meta.get(_code, _method_meta['other']) %}
            {% else %}
              {% set _meta = _reason_meta.get(_code, _reason_meta['other_debit']) %}
            {% endif %}
            <article class="fin-row fin-row-{{ entry.entry_type }}">
              <span class="fin-row-icon">{{ '↑' if _is_credit else '↓' }}</span>
              <div class="fin-row-body">
                <strong>
                  {{ ('Credit' if is_en else 'إضافة رصيد') if _is_credit else ('Debit' if is_en else 'خصم رصيد') }}
                  <span class="fin-method-pill {{ _meta.cls }}">{{ _meta.icon }} {{ _meta.label_en if is_en else _meta.label_ar }}</span>
                </strong>
                <small>{{ _real_ref or ('No reference' if is_en else 'بدون مرجع') }}{% if entry.note %} · {{ entry.note }}{% endif %}</small>
              </div>
              <div class="fin-row-amount">
                <b>{{ '+' if _is_credit else '−' }}{{ entry.amount }} <small>{{ entry.currency }}</small></b>
                <small>{{ format_local(entry.created_at) if entry.created_at else '' }}</small>
              </div>
            </article>
          {% else %}
            <div class="fin-empty">
              <span>📭</span>
              <strong>{{ 'No movements yet.' if is_en else 'لا توجد حركات مالية بعد.' }}</strong>
              <small>{{ 'Use the form to add the first credit or debit.' if is_en else 'استخدم النموذج لإضافة أول حركة.' }}</small>
            </div>
          {% endfor %}
        </div>
      </article>
    </div>

    {# ─── Side ─── #}
    <aside class="prof-side">
      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Snapshot' if is_en else 'الملخص' }}</span></header>
        <strong class="prof-side-title">{{ '%.2f'|format(wallet_balance or 0) }} USD</strong>
        <div class="prof-side-rows">
          <div><span>↑ {{ 'Credits' if is_en else 'الإضافات' }}</span><b>{{ credits|length }}</b></div>
          <div><span>↓ {{ 'Debits' if is_en else 'الخصومات' }}</span><b>{{ debits|length }}</b></div>
          <div><span>{{ 'Net' if is_en else 'الصافي' }}</span><b>{{ '%.2f'|format(total_credit - total_debit) }}</b></div>
        </div>
      </section>

      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Top reasons' if is_en else 'أبرز الأسباب' }}</span></header>
        <div class="prof-side-rows">
          {% set _top = {'renew_sub':0,'renew_quota':0,'add_device':0,'service_fee':0,'refund':0,'penalty':0,'sms_topup':0,'cash_out':0,'other_debit':0} %}
          {% for entry in debits %}
            {% set _r = entry.reference or '' %}
            {% set _c = 'other_debit' %}
            {% if _r.startswith('[') and ']' in _r %}
              {% set _e = _r.find(']') %}
              {% set _maybe = _r[1:_e] %}
              {% if _maybe in _top %}{% set _c = _maybe %}{% endif %}
            {% endif %}
            {% if _top.update({_c: _top[_c]+1}) %}{% endif %}
          {% endfor %}
          <div><span>🔄 {{ 'Renew subscription' if is_en else 'تجديد اشتراك' }}</span><b>{{ _top.renew_sub }}</b></div>
          <div><span>📊 {{ 'Renew quota' if is_en else 'تجديد كوتة' }}</span><b>{{ _top.renew_quota }}</b></div>
          <div><span>⚡ {{ 'Add device' if is_en else 'إضافة جهاز' }}</span><b>{{ _top.add_device }}</b></div>
          <div><span>🛠️ {{ 'Service fee' if is_en else 'رسوم خدمة' }}</span><b>{{ _top.service_fee }}</b></div>
          <div><span>💸 {{ 'Refund' if is_en else 'استرداد' }}</span><b>{{ _top.refund }}</b></div>
        </div>
      </section>

      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Latest entry' if is_en else 'آخر حركة' }}</span></header>
        {% set last = finance_rows[0] if finance_rows else None %}
        {% if last %}
        <strong class="prof-side-title {{ 'fin-credit-tone' if last.entry_type == 'credit' else 'fin-debit-tone' }}">{{ '+' if last.entry_type == 'credit' else '−' }}{{ last.amount }} {{ last.currency }}</strong>
        <div class="prof-side-rows">
          <div><span>{{ 'Type' if is_en else 'النوع' }}</span><b>{{ ('Credit' if is_en else 'إضافة') if last.entry_type == 'credit' else ('Debit' if is_en else 'خصم') }}</b></div>
          <div><span>{{ 'When' if is_en else 'متى' }}</span><b>{{ format_local(last.created_at) if last.created_at else '—' }}</b></div>
        </div>
        {% else %}
        <small class="sub-side-hint">{{ 'No entries yet.' if is_en else 'لا توجد حركات بعد.' }}</small>
        {% endif %}
      </section>
    </aside>
  </div>
</div>{# /.prof-shell #}

<script>
(function(){
  const finPane = document.querySelector('[data-up-pane="finance"]');
  if(!finPane) return;
  const form         = finPane.querySelector('[data-fin-form]');
  const typeSel      = finPane.querySelector('[data-fin-type]');
  const creditSec    = finPane.querySelector('[data-fin-credit-section]');
  const debitSec     = finPane.querySelector('[data-fin-debit-section]');
  const subQuota     = finPane.querySelector('[data-fin-sub-quota]');
  const methodInput  = finPane.querySelector('#fin-method');
  const reasonInput  = finPane.querySelector('#fin-reason');
  const reasonMeta   = finPane.querySelector('#fin-reason-meta');
  const refInput     = finPane.querySelector('#fin-reference');
  const quotaTarget  = finPane.querySelector('#fin-quota-target');
  const amtEl        = finPane.querySelector('#fin-amount');

  function syncView(){
    const t = typeSel.value;
    if(t === 'debit'){
      if(creditSec) creditSec.setAttribute('hidden','');
      if(debitSec)  debitSec.removeAttribute('hidden');
      if(subQuota){
        if(reasonInput.value === 'renew_quota') subQuota.removeAttribute('hidden');
        else subQuota.setAttribute('hidden','');
      }
    } else {
      if(creditSec) creditSec.removeAttribute('hidden');
      if(debitSec)  debitSec.setAttribute('hidden','');
      if(subQuota)  subQuota.setAttribute('hidden','');
    }
  }
  typeSel.addEventListener('change', syncView);

  // Method cards (credit)
  finPane.querySelectorAll('.fin-card[data-method]').forEach(function(card){
    card.addEventListener('click', function(){
      finPane.querySelectorAll('.fin-card[data-method]').forEach(function(c){
        c.classList.remove('is-on'); c.setAttribute('aria-checked','false');
      });
      card.classList.add('is-on'); card.setAttribute('aria-checked','true');
      if(methodInput) methodInput.value = card.dataset.method;
    });
  });

  // Reason cards (debit)
  finPane.querySelectorAll('.fin-card[data-reason]').forEach(function(card){
    card.addEventListener('click', function(){
      finPane.querySelectorAll('.fin-card[data-reason]').forEach(function(c){
        c.classList.remove('is-on'); c.setAttribute('aria-checked','false');
      });
      card.classList.add('is-on'); card.setAttribute('aria-checked','true');
      if(reasonInput) reasonInput.value = card.dataset.reason;
      // Toggle the quota sub-selector
      if(subQuota){
        if(card.dataset.reason === 'renew_quota') subQuota.removeAttribute('hidden');
        else subQuota.setAttribute('hidden','');
      }
    });
  });

  // Quick presets
  finPane.querySelectorAll('[data-fin-set]').forEach(function(btn){
    btn.addEventListener('click', function(){
      try{
        const cfg = JSON.parse(btn.dataset.finSet);
        if(typeSel && cfg.type) typeSel.value = cfg.type;
        if(amtEl  && cfg.amount) amtEl.value = cfg.amount;
        syncView();
        if(amtEl){
          amtEl.style.transition = 'background-color .25s';
          amtEl.style.backgroundColor = cfg.type === 'credit' ? '#ecfdf5' : '#fef2f2';
          setTimeout(function(){ amtEl.style.backgroundColor = ''; }, 600);
          amtEl.focus();
        }
      }catch(_){}
    });
  });

  // On submit: prefix reference with [code] (method for credit, reason for debit)
  if(form){
    form.addEventListener('submit', function(){
      const isCredit = typeSel.value === 'credit';
      let code;
      if(isCredit){
        code = methodInput ? methodInput.value : 'other';
      } else {
        code = reasonInput ? reasonInput.value : 'other_debit';
        // For renew_quota, append the chosen quota target
        if(code === 'renew_quota' && quotaTarget){
          code = 'renew_quota:' + quotaTarget.value;
        }
      }
      if(refInput && !(refInput.value || '').startsWith('[')){
        refInput.value = '[' + code + ']' + (refInput.value || '');
      }
    });
  }

  syncView();
})();
</script>
</div>
<div class="up-pane" data-up-pane="quotas" {% if tab != 'quotas' %}hidden{% endif %}>
<div class="prof-shell">
  {% set q_active = quota_rows|selectattr('status','equalto','active')|list %}
  {% set q_paused = quota_rows|selectattr('status','equalto','paused')|list %}
  {% set q_warn = quota_rows|selectattr('limit_value')|list %}

  {# ─── Quotas summary hero with multi-ring ─── #}
  <section class="qta-hero">
    <div class="qta-hero-text">
      <span class="qta-hero-eyebrow">📊 {{ 'Quotas' if is_en else 'الكوتا' }}</span>
      <h2>{{ 'Usage limits and service quotas' if is_en else 'حدود الاستخدام والكوتا' }}</h2>
      <p>{{ 'Choose a quota type, set the limit, period, and status. The subscriber is already selected from this 360 profile.' if is_en else 'اختر نوع الكوتا وحدد الحد والفترة والحالة. لا تحتاج كتابة اسم المشترك لأنك داخل ملفه الشخصي.' }}</p>
      <div class="qta-hero-stats">
        <div class="qta-mini" style="--c:#7c3aed"><span>📊</span><div><small>{{ 'Total quotas' if is_en else 'إجمالي البنود' }}</small><strong>{{ quota_rows|length }}</strong></div></div>
        <div class="qta-mini" style="--c:#10b981"><span>✓</span><div><small>{{ 'Active' if is_en else 'نشطة' }}</small><strong>{{ q_active|length }}</strong></div></div>
        <div class="qta-mini" style="--c:#f59e0b"><span>⏸</span><div><small>{{ 'Paused' if is_en else 'متوقفة' }}</small><strong>{{ q_paused|length }}</strong></div></div>
      </div>
    </div>
    {# rings removed — replaced by per-card donuts below #}
  </section>

  <div class="prof-grid">
    <div>
      {# ─── Step 1: Create / update quota ─── #}
      <form method="post" class="prof-form" id="quotaFormV111">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="action" value="quota_save">
        <input type="hidden" name="quota_id" id="quotaIdV113" value="">

        <article class="prof-step">
          <div class="prof-step-side">
            <span class="prof-step-num">1</span>
            <span class="prof-step-icon">📐</span>
            <small>{{ 'Step 1' if is_en else 'الخطوة 1' }}</small>
            <h3 id="quotaFormTitleV113">{{ 'Create or update quota' if is_en else 'إنشاء أو تحديث كوتا' }}</h3>
            <p>{{ 'If the same quota already exists, this form updates it automatically.' if is_en else 'إذا كانت الكوتا موجودة مسبقاً سيتم تحديثها تلقائياً بدل بند مكرر.' }}</p>
          </div>
          <div class="prof-step-body">
            <label class="prof-field prof-field-full">
              <span>{{ 'Quota type' if is_en else 'نوع الكوتا' }}</span>
              <select class="prof-input" name="quota_key" id="quotaPresetV111">
                {% for opt in quota_key_options %}<option value="{{ opt.value }}" data-label="{{ opt.label }}" data-limit="{{ opt.default_limit or '' }}" data-period="{{ opt.default_period or 'manual' }}" data-unit="{{ opt.unit or '' }}" data-description="{{ opt.description or '' }}">{{ opt.label }}</option>{% endfor %}
              </select>
              <small id="quotaPresetHintV111" class="qta-hint"></small>
            </label>
            <label class="prof-field prof-field-full" id="quotaCustomWrapV111" style="display:none">
              <span>{{ 'Custom quota key' if is_en else 'مفتاح مخصص' }}</span>
              <input class="prof-input prof-input-ltr" name="custom_key" id="quotaCustomKeyV111" placeholder="custom_limit">
            </label>
            <label class="prof-field">
              <span>{{ 'Display name' if is_en else 'الاسم الظاهر' }}</span>
              <input class="prof-input" name="quota_label" id="quotaLabelV111" placeholder="{{ 'Shown in summaries' if is_en else 'يظهر في الملخصات' }}">
            </label>
            <label class="prof-field">
              <span>{{ 'Limit' if is_en else 'الحد' }} <em>*</em></span>
              <input class="prof-input" name="limit_value" id="quotaLimitV111" type="number" min="0" step="1" required placeholder="50">
            </label>
            <label class="prof-field">
              <span>{{ 'Reset period' if is_en else 'فترة التصفير' }}</span>
              <select class="prof-input" name="reset_period" id="quotaResetV111">
                <option value="manual">{{ ui_label('manual', 'status', ui_lang) }}</option>
                <option value="daily">{{ ui_label('daily', 'status', ui_lang) }}</option>
                <option value="weekly">{{ ui_label('weekly', 'status', ui_lang) }}</option>
                <option value="monthly">{{ ui_label('monthly', 'status', ui_lang) }}</option>
                <option value="yearly">{{ ui_label('yearly', 'status', ui_lang) }}</option>
              </select>
            </label>
            <label class="prof-field">
              <span>{{ 'Status' if is_en else 'الحالة' }}</span>
              <select class="prof-input" name="status">
                <option value="active">{{ ui_label('active', 'status', ui_lang) }}</option>
                <option value="paused">{{ ui_label('paused', 'status', ui_lang) }}</option>
                <option value="exhausted">{{ ui_label('exhausted', 'status', ui_lang) }}</option>
              </select>
            </label>
            <label class="prof-field prof-field-full">
              <span>{{ 'Notes' if is_en else 'ملاحظات' }}</span>
              <textarea class="prof-input" name="notes" id="quotaNotesV111" rows="2" placeholder="{{ 'Optional internal note' if is_en else 'ملاحظة داخلية اختيارية' }}"></textarea>
            </label>
          </div>
        </article>

        <div class="prof-savebar">
          <span class="prof-savebar-hint">💡 {{ 'Saving creates or updates the quota. Restart needed for some types.' if is_en else 'الحفظ ينشئ أو يحدّث البند فوراً.' }}</span>
          <div class="prof-savebar-actions">
            <button type="button" class="prof-btn prof-btn-ghost" id="quotaResetFormV113">+ {{ 'New quota' if is_en else 'كوتا جديدة' }}</button>
            <button class="prof-btn prof-btn-primary" type="submit">💾 {{ 'Save quota' if is_en else 'حفظ الكوتا' }}</button>
          </div>
        </div>
      </form>

      {# ─── Step 2: Current quotas as donut cards ─── #}
      <article class="prof-step" style="margin-top:18px">
        <div class="prof-step-side">
          <span class="prof-step-num">2</span>
          <span class="prof-step-icon">📈</span>
          <small>{{ 'Step 2' if is_en else 'الخطوة 2' }}</small>
          <h3>{{ 'Current quotas' if is_en else 'الكوتا الحالية' }}</h3>
          <p>{{ 'Color-coded by usage. Green = healthy, amber = warning, red = exceeded.' if is_en else 'مرمَّز بالألوان. أخضر = جيد، برتقالي = تحذير، أحمر = متجاوز.' }}</p>
        </div>
        <div class="prof-step-body qta-grid" style="grid-template-columns:1fr">
          {% for row in quota_rows %}
            {% set is_unlim = row.is_unlimited or row.reset_period == 'unlimited' %}
            {% set raw_pct = 0 if is_unlim else (((row.used_value or 0) / row.limit_value * 100) if row.limit_value else 0) %}
            {% set pct = raw_pct|round(0)|int %}
            {% set cap = 100 if pct > 100 else pct %}
            {% set tone = 'danger' if pct >= 100 else ('warn' if pct >= 75 else 'ok') %}
            {% set remaining = '∞' if is_unlim else ((row.limit_value or 0) - (row.used_value or 0)) %}
            <article class="qta-card qta-card-{{ tone }}">
              <div class="qta-card-donut" style="--pct:{{ cap if not is_unlim else 100 }};--c:{{ '#ef4444' if tone=='danger' else '#f59e0b' if tone=='warn' else '#10b981' }}">
                <div class="qta-card-donut-inner">
                  <span class="qta-card-donut-num">{% if is_unlim %}∞{% else %}{{ pct }}%{% endif %}</span>
                </div>
              </div>
              <div class="qta-card-body">
                <div class="qta-card-head">
                  <strong>{{ row.quota_label or row.quota_key }}</strong>
                  <span class="status-pill {{ 'success' if row.status=='active' else 'warning' }}">{{ ui_label(row.status, 'status', ui_lang) }}</span>
                </div>
                <small class="qta-card-meta">{{ row.quota_key }} · {{ ui_label(row.reset_period, 'status', ui_lang) }} · {% if row.source == 'plan' %}{{ 'From plan' if is_en else 'من الخطة' }}{% elif row.source == 'override' %}{{ 'Override' if is_en else 'تعديل' }}{% else %}{{ 'Custom' if is_en else 'مخصص' }}{% endif %}</small>
                <div class="qta-card-stats">
                  <span><b>{{ row.used_value|round(0)|int }}</b><small>{{ 'Used' if is_en else 'مستخدم' }}</small></span>
                  <span><b>{% if is_unlim %}∞{% else %}{{ row.limit_value|round(0)|int }}{% endif %}</b><small>{{ 'Limit' if is_en else 'الحد' }}</small></span>
                  <span><b>{% if is_unlim %}∞{% else %}{{ 0 if remaining < 0 else remaining|round(0)|int }}{% endif %}</b><small>{{ 'Left' if is_en else 'متبقي' }}</small></span>
                </div>
                <div class="qta-card-bar"><i style="width:{{ cap if not is_unlim else 100 }}%;background:{{ '#ef4444' if tone=='danger' else '#f59e0b' if tone=='warn' else '#10b981' }}"></i></div>
                <div class="qta-card-actions">
                  <button class="qta-card-btn qta-card-edit" type="button"
                    data-id="{{ row.id }}"
                    data-key="{{ row.quota_key }}"
                    data-label="{{ row.quota_label or '' }}"
                    data-limit="{{ row.limit_value or 0 }}"
                    data-used="{{ row.used_value or 0 }}"
                    data-period="{{ row.reset_period or 'manual' }}"
                    data-status="{{ row.status or 'active' }}"
                    data-unlimited="{{ '1' if is_unlim else '0' }}"
                    data-notes="{{ row.notes or '' }}">✎ {{ 'Edit' if is_en else 'تعديل' }}</button>
                  <form method="post" class="qta-card-delete" onsubmit="return confirm('{{ 'Delete this quota permanently?' if is_en else 'حذف هذا الحد نهائياً؟' }}');" style="display:inline">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="action" value="quota_delete">
                    <input type="hidden" name="quota_id" value="{{ row.id }}">
                    <button class="qta-card-btn qta-card-del" type="submit">🗑 {{ 'Delete' if is_en else 'حذف' }}</button>
                  </form>
                </div>
              </div>
            </article>
          {% else %}
            <div class="qta-empty">
              <span>📊</span>
              <strong>{{ 'No quotas yet.' if is_en else 'لا توجد كوتا بعد.' }}</strong>
              <small>{{ 'Add the first quota from the form above. Start with SMS or devices.' if is_en else 'أضف أول كوتا من النموذج أعلاه. ابدأ بحد الرسائل أو الأجهزة.' }}</small>
            </div>
          {% endfor %}
        </div>
      </article>
    </div>

    <aside class="prof-side">
      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Quick legend' if is_en else 'دلالة الألوان' }}</span></header>
        <div class="prof-side-rows">
          <div><span style="color:#10b981">●</span><span>{{ '< 75% — healthy' if is_en else '< 75% — جيد' }}</span><b></b></div>
          <div><span style="color:#f59e0b">●</span><span>{{ '75–99% — warning' if is_en else '75–99% — تحذير' }}</span><b></b></div>
          <div><span style="color:#ef4444">●</span><span>{{ '≥ 100% — exceeded' if is_en else '≥ 100% — متجاوز' }}</span><b></b></div>
        </div>
      </section>

      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Top consumers' if is_en else 'الأعلى استهلاكاً' }}</span></header>
        <div class="prof-side-rows">
          {% set sorted_quotas = quota_rows|rejectattr('is_unlimited')|sort(attribute='used_value', reverse=true) %}
          {% for row in sorted_quotas[:4] %}
          {% set p = (((row.used_value or 0) / row.limit_value * 100) if row.limit_value else 0)|round(0)|int %}
          <div><span>{{ row.quota_label or row.quota_key }}</span><b>{{ p }}%</b></div>
          {% else %}
          <div><span>—</span><b>—</b></div>
          {% endfor %}
        </div>
      </section>
    </aside>
  </div>
</div>{# /.prof-shell #}

<script>
(function(){
  const preset = document.getElementById('quotaPresetV111');
  const hint = document.getElementById('quotaPresetHintV111');
  const label = document.getElementById('quotaLabelV111');
  const limit = document.getElementById('quotaLimitV111');
  const reset = document.getElementById('quotaResetV111');
  const notes = document.getElementById('quotaNotesV111');
  const customWrap = document.getElementById('quotaCustomWrapV111');
  const customKey = document.getElementById('quotaCustomKeyV111');
  const quotaId = document.getElementById('quotaIdV113');
  const title = document.getElementById('quotaFormTitleV113');
  const resetBtn = document.getElementById('quotaResetFormV113');
  const form = document.getElementById('quotaFormV111');
  if(!form || !preset) return;
  const statusSelect = form.querySelector('[name="status"]');

  function optionFor(value){ return Array.from(preset.options).find(o => o.value === value); }
  function setCustomMode(key){
    const found = optionFor(key);
    preset.value = found ? key : 'custom';
    if(!found && customKey) customKey.value = key || '';
    if(customWrap) customWrap.style.display = preset.value === 'custom' ? 'flex' : 'none';
  }
  function syncQuotaPreset(forceDefaults){
    const opt = preset.options[preset.selectedIndex];
    const isCustom = opt && opt.value === 'custom';
    if(customWrap) customWrap.style.display = isCustom ? 'flex' : 'none';
    if(hint) hint.textContent = (opt && opt.dataset.description) || '';
    if(forceDefaults){
      if(label) label.value = (opt && opt.dataset.label) || '';
      if(limit) limit.value = (opt && opt.dataset.limit) || '';
      if(reset && opt && opt.dataset.period) reset.value = opt.dataset.period;
      if(notes) notes.value = '';
      if(customKey && !isCustom) customKey.value = '';
    } else {
      if(label && !label.value && opt) label.value = opt.dataset.label || '';
      if(limit && (!limit.value || limit.value === '0') && opt) limit.value = opt.dataset.limit || '';
      if(reset && opt && opt.dataset.period && !reset.value) reset.value = opt.dataset.period;
    }
  }
  preset.addEventListener('change', function(){ syncQuotaPreset(true); });

  document.querySelectorAll('.qta-card-edit').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.preventDefault();
      if(quotaId) quotaId.value = btn.dataset.id || '';
      setCustomMode(btn.dataset.key || '');
      if(label) label.value = btn.dataset.label || btn.dataset.key || '';
      if(limit) limit.value = btn.dataset.limit || '0';
      if(reset) reset.value = btn.dataset.period || 'manual';
      if(statusSelect) statusSelect.value = btn.dataset.status || 'active';
      if(notes) notes.value = btn.dataset.notes || '';
      if(title) title.textContent = '{{ "Edit quota" if is_en else "تعديل الكوتا" }}';
      syncQuotaPreset(false);
      form.scrollIntoView({behavior:'smooth', block:'start'});
    });
  });

  if(resetBtn){
    resetBtn.addEventListener('click', function(){
      form.reset();
      if(quotaId) quotaId.value = '';
      if(customKey) customKey.value = '';
      if(title) title.textContent = '{{ "Create or update quota" if is_en else "إنشاء أو تحديث كوتا" }}';
      syncQuotaPreset(true);
      form.scrollIntoView({behavior:'smooth', block:'start'});
    });
  }
  syncQuotaPreset(false);
})();
</script>
</div>

<div class="up-pane" data-up-pane="devices" {% if tab != 'devices' %}hidden{% endif %}>
<div class="prof-shell">
  {% set active_devices = devices|selectattr('is_active')|list %}
  {% set connected_devices = devices|selectattr('is_active')|selectattr('connection_status','in',['ok','connected','ready'])|list %}

  {# ─── Hero ─── #}
  <section class="dev2-hero">
    <div class="dev2-hero-text">
      <span class="dev2-hero-eyebrow">⚡ {{ 'Device fleet' if is_en else 'أسطول الأجهزة' }}</span>
      <h2>{{ 'Subscriber devices' if is_en else 'أجهزة المشترك' }}</h2>
      <p>{{ 'Live status, sync timeline, and quick actions per device.' if is_en else 'حالة لحظية، توقيت آخر مزامنة، وإجراءات سريعة لكل جهاز.' }}</p>
      <div class="dev2-hero-stats">
        <div class="dev2-mini" style="--c:#7c3aed"><span>📦</span><div><small>{{ 'Total' if is_en else 'الإجمالي' }}</small><strong>{{ devices|length }}</strong></div></div>
        <div class="dev2-mini" style="--c:#10b981"><span>✅</span><div><small>{{ 'Active' if is_en else 'مفعّلة' }}</small><strong>{{ active_devices|length }}</strong></div></div>
        <div class="dev2-mini" style="--c:#2563eb"><span>📡</span><div><small>{{ 'Connected' if is_en else 'متصلة' }}</small><strong>{{ connected_devices|length }}</strong></div></div>
        <div class="dev2-mini" style="--c:#f59e0b"><span>⏳</span><div><small>{{ 'Pending' if is_en else 'قيد الفحص' }}</small><strong>{{ (active_devices|length) - (connected_devices|length) }}</strong></div></div>
      </div>
    </div>
  </section>

  <div class="prof-grid">
    <div>
      <div class="dev2-grid">
        {% for device in devices %}
          {% set _dt = (device.device_type or 'deye')|lower %}
          {% set provider_icon = '☀️' if 'deye' in _dt else ('⚡' if 'tesla' in _dt else ('🔋' if 'victron' in _dt else ('☁️' if 'huawei' in _dt or 'sungrow' in _dt or 'goodwe' in _dt else ('🏠' if 'fronius' in _dt or 'opendtu' in _dt else '⚡')))) %}
          {% set provider_label = device.device_type|capitalize if device.device_type else 'Generic' %}
          {% set provider_class = 'prov-deye' if 'deye' in _dt else ('prov-tesla' if 'tesla' in _dt else ('prov-victron' if 'victron' in _dt else ('prov-cloud' if 'huawei' in _dt or 'sungrow' in _dt or 'goodwe' in _dt else ('prov-local' if 'fronius' in _dt or 'opendtu' in _dt else 'prov-generic')))) %}
          {% set connected = (device.connection_status or '') in ['ok','connected','ready'] %}
          {% set status_kind = 'ok' if (connected and device.is_active) else ('warn' if device.is_active else 'off') %}
          {# Estimate signal bars (3-4 if connected, 1-2 if pending, 0 if disabled) #}
          {% set signal_bars = 4 if connected and device.is_active else (2 if device.is_active else 0) %}

          <article class="dev2-card dev2-card-{{ status_kind }}">
            {# Top banner with provider gradient + live pulse #}
            <header class="dev2-card-banner {{ provider_class }}">
              <span class="dev2-card-glyph">{{ provider_icon }}</span>
              <div class="dev2-card-banner-title">
                <strong>{{ device.name }}</strong>
                <small>{{ device.plant_name or ('No plant' if is_en else 'بدون محطة') }}</small>
              </div>
              <span class="dev2-pulse dev2-pulse-{{ status_kind }}" title="{{ 'Live' if connected else ('Pending' if device.is_active else 'Off') }}">
                <i></i>
                <em>{{ 'LIVE' if connected and is_en else ('متصل' if connected else ('قيد الفحص' if device.is_active and not is_en else ('معطّل' if not device.is_active and not is_en else 'PENDING'))) }}</em>
              </span>
            </header>

            {# Mid stats — 4 cells in a strip #}
            <div class="dev2-card-stats">
              <div class="dev2-stat">
                <small>{{ 'Provider' if is_en else 'المزوّد' }}</small>
                <strong>{{ provider_label }}</strong>
              </div>
              <div class="dev2-stat">
                <small>{{ 'Connection' if is_en else 'الربط' }}</small>
                <strong class="dev2-stat-status status-{{ status_kind }}">
                  {% if connected %}{{ 'Connected' if is_en else 'متصل' }}
                  {% elif device.is_active %}{{ 'Pending' if is_en else 'قيد الفحص' }}
                  {% else %}{{ 'Disabled' if is_en else 'معطّل' }}{% endif %}
                </strong>
              </div>
              <div class="dev2-stat">
                <small>{{ 'Signal' if is_en else 'الإشارة' }}</small>
                <span class="dev2-signal" data-bars="{{ signal_bars }}">
                  <i class="b1"></i><i class="b2"></i><i class="b3"></i><i class="b4"></i>
                </span>
              </div>
              <div class="dev2-stat">
                <small>{{ 'Last sync' if is_en else 'آخر مزامنة' }}</small>
                <strong class="dev2-stat-time">{{ format_local(device.last_connected_at) if device.last_connected_at else ('—' if is_en else '—') }}</strong>
              </div>
            </div>

            {# Service status strip — operational only, no personal data #}
            {% set has_auth = (device.auth_mode and device.auth_mode != 'wizard') or (device.credentials_json and device.credentials_json|length > 5) %}
            {% set has_api  = device.api_base_url and device.api_base_url|length > 5 %}
            {% set has_sync = device.last_connected_at is not none %}
            {% set sync_recent = false %}
            {% if device.last_connected_at %}
              {# best-effort recency proxy: if last_connected_at exists and connection is ok #}
              {% set sync_recent = connected %}
            {% endif %}
            <div class="dev2-services">
              <span class="dev2-services-lbl">{{ 'Services' if is_en else 'حالة الخدمات' }}</span>
              <span class="dev2-svc {{ 'svc-ok' if has_auth else 'svc-fail' }}" title="{{ 'Credentials provided' if is_en else 'بيانات الاعتماد' }}">
                <i>🔐</i>
                <em>{{ 'Auth' if is_en else 'الاعتماد' }}</em>
                <b>{{ '✓' if has_auth else '✗' }}</b>
              </span>
              <span class="dev2-svc {{ 'svc-ok' if has_api else 'svc-fail' }}" title="{{ 'API endpoint configured' if is_en else 'رابط الـ API' }}">
                <i>🌐</i>
                <em>API URL</em>
                <b>{{ '✓' if has_api else '✗' }}</b>
              </span>
              <span class="dev2-svc {{ 'svc-ok' if connected else ('svc-warn' if device.is_active else 'svc-fail') }}" title="{{ 'Live connection' if is_en else 'حالة الاتصال' }}">
                <i>📡</i>
                <em>{{ 'Link' if is_en else 'الاتصال' }}</em>
                <b>{% if connected %}✓{% elif device.is_active %}⏳{% else %}✗{% endif %}</b>
              </span>
              <span class="dev2-svc {{ 'svc-ok' if sync_recent else ('svc-warn' if has_sync else 'svc-fail') }}" title="{{ 'Last sync recency' if is_en else 'حداثة آخر مزامنة' }}">
                <i>⏱️</i>
                <em>{{ 'Sync' if is_en else 'المزامنة' }}</em>
                <b>{% if sync_recent %}✓{% elif has_sync %}⚠{% else %}✗{% endif %}</b>
              </span>
            </div>

            {# Status badge + popup menu #}
            <div class="dev2-card-foot">
              {% if not device.is_active %}
                <p class="dev2-note danger">⚠ {{ 'Device disabled.' if is_en else 'الجهاز معطّل.' }}</p>
              {% elif connected %}
                <p class="dev2-note success">✓ {{ 'Healthy connection.' if is_en else 'الربط جاهز وسليم.' }}</p>
              {% else %}
                <p class="dev2-note warning">⏳ {{ 'Waiting for verification.' if is_en else 'بانتظار الفحص أو المزامنة.' }}</p>
              {% endif %}

              <div class="dev2-card-actions">
                <button type="button" class="dev2-btn dev2-btn-edit" data-dev-edit
                  data-id="{{ device.id }}"
                  data-name="{{ device.name|e }}"
                  data-plant="{{ (device.plant_name or '')|e }}"
                  data-timezone="{{ device.timezone or 'Asia/Hebron' }}"
                  data-api-url="{{ (device.api_base_url or '')|e }}"
                  data-notes="{{ (device.notes or '')|e }}"
                  data-active="{{ '1' if device.is_active else '0' }}"
                  data-provider="{{ (device.device_type or 'deye')|e }}">
                  ✎ {{ 'Edit' if is_en else 'تعديل' }}
                </button>
                <button type="button" class="dev2-btn dev2-btn-sync" data-dev-action="sync" data-device-id="{{ device.id }}">
                  🔄 {{ 'Sync' if is_en else 'مزامنة' }}
                </button>
              </div>
            </div>
          </article>
        {% else %}
          <div class="dev2-empty">
            <span>⚡</span>
            <strong>{{ 'No devices linked yet.' if is_en else 'لا توجد أجهزة مرتبطة بعد.' }}</strong>
            <small>{{ 'The subscriber will add devices from their portal.' if is_en else 'يضيف المشترك أجهزته من بوابته.' }}</small>
          </div>
        {% endfor %}
      </div>
    </div>

    <aside class="prof-side">
      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Provider mix' if is_en else 'توزيع المزودين' }}</span></header>
        <div class="prof-side-rows">
          {% set providers = devices|map(attribute='device_type')|select|list %}
          {% set deye_count = providers|select('==','deye')|list|length %}
          {% set other_count = (providers|length) - deye_count %}
          <div><span>☀️ Deye</span><b>{{ deye_count }}</b></div>
          <div><span>⚡ {{ 'Others' if is_en else 'أخرى' }}</span><b>{{ other_count }}</b></div>
        </div>
      </section>

      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Health' if is_en else 'الحالة الصحية' }}</span></header>
        <div class="prof-side-rows">
          <div><span>✅ {{ 'Connected' if is_en else 'متصل' }}</span><b>{{ connected_devices|length }}</b></div>
          <div><span>⏳ {{ 'Pending' if is_en else 'قيد الفحص' }}</span><b>{{ (active_devices|length) - (connected_devices|length) }}</b></div>
          <div><span>⚪ {{ 'Disabled' if is_en else 'معطّل' }}</span><b>{{ (devices|length) - (active_devices|length) }}</b></div>
        </div>
      </section>

      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Quick tips' if is_en else 'تذكير سريع' }}</span></header>
        <small class="sub-side-hint">{{ 'Click a card icon for full provider docs. Sync resends credentials and tests the link.' if is_en else 'اضغط أيقونة المزوّد للمستندات الفنية. زر المزامنة يعيد بيانات الربط ويختبر الاتصال.' }}</small>
      </section>
    </aside>
  </div>
</div>{# /.prof-shell #}


{# ─── Device edit modal (admin-allowed fields only) ─── #}
<div class="dev2-modal" data-dev-modal hidden>
  <div class="dev2-modal-backdrop" data-dev-modal-close></div>
  <div class="dev2-modal-card" role="dialog" aria-modal="true" aria-labelledby="devModalTitle">
    <header class="dev2-modal-head">
      <div>
        <span class="dev2-modal-eyebrow">⚡ {{ 'Edit device' if is_en else 'تعديل الجهاز' }}</span>
        <h3 id="devModalTitle" data-dev-modal-title>—</h3>
      </div>
      <button type="button" class="dev2-modal-close" data-dev-modal-close aria-label="Close">✕</button>
    </header>
    <div class="dev2-modal-body">
      <p class="dev2-modal-hint">{{ 'Only operational fields are editable. Credentials and energy data stay private to the subscriber.' if is_en else 'الحقول التشغيلية فقط قابلة للتعديل. بيانات الاعتماد ومعلومات الطاقة تبقى خاصة بالمشترك.' }}</p>
      <div class="dev2-modal-grid">
        <label class="dev2-field">
          <span>{{ 'Device name' if is_en else 'اسم الجهاز' }} <em>*</em></span>
          <input class="prof-input" data-dev-modal-field="name" placeholder="{{ 'e.g. Main solar' if is_en else 'مثلاً: محطة المنزل' }}">
        </label>
        <label class="dev2-field">
          <span>{{ 'Plant / site name' if is_en else 'اسم المحطة' }}</span>
          <input class="prof-input" data-dev-modal-field="plant" placeholder="{{ 'Optional' if is_en else 'اختياري' }}">
        </label>
        <label class="dev2-field">
          <span>{{ 'Timezone' if is_en else 'المنطقة الزمنية' }}</span>
          <select class="prof-input" data-dev-modal-field="timezone">
            <option value="Asia/Hebron">Asia/Hebron — فلسطين</option>
            <option value="Asia/Amman">Asia/Amman — الأردن</option>
            <option value="Asia/Riyadh">Asia/Riyadh — السعودية</option>
            <option value="Asia/Dubai">Asia/Dubai — الإمارات</option>
            <option value="Africa/Cairo">Africa/Cairo — مصر</option>
            <option value="UTC">UTC</option>
          </select>
        </label>
        <label class="dev2-field">
          <span>{{ 'API base URL' if is_en else 'رابط API الأساسي' }}</span>
          <input class="prof-input prof-input-ltr" data-dev-modal-field="api_url" placeholder="https://...">
        </label>
        <label class="dev2-field dev2-field-full">
          <span>{{ 'Admin notes' if is_en else 'ملاحظات الإدارة' }}</span>
          <textarea class="prof-input" rows="2" data-dev-modal-field="notes" placeholder="{{ 'Internal note' if is_en else 'ملاحظة داخلية' }}"></textarea>
        </label>
        <label class="dev2-field dev2-field-full dev2-toggle">
          <input type="checkbox" data-dev-modal-field="active">
          <div>
            <strong>{{ 'Device active' if is_en else 'الجهاز مُفعّل' }}</strong>
            <small>{{ 'When disabled, sync stops and data is hidden in dashboards.' if is_en else 'عند التعطيل تتوقف المزامنة ولا تظهر بيانات الجهاز.' }}</small>
          </div>
        </label>
      </div>
    </div>
    <footer class="dev2-modal-foot">
      <button type="button" class="prof-btn prof-btn-ghost" data-dev-action="copy-id-modal">📋 {{ 'Copy ID' if is_en else 'نسخ المعرّف' }}</button>
      <div class="dev2-modal-foot-actions">
        <button type="button" class="prof-btn prof-btn-ghost" data-dev-modal-close>{{ 'Cancel' if is_en else 'إلغاء' }}</button>
        <button type="button" class="prof-btn prof-btn-primary" data-dev-modal-save>💾 {{ 'Save changes' if is_en else 'حفظ التعديلات' }}</button>
      </div>
    </footer>
  </div>
</div>
<script>
(function(){
  const pane = document.querySelector('[data-up-pane="devices"]');
  if(!pane) return;
  const isEn = (document.documentElement.lang === 'en');

  function toast(msg, kind){
    const t = document.createElement('div');
    t.className = 'dev2-toast ' + (kind || 'info');
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(function(){ t.classList.add('show'); }, 10);
    setTimeout(function(){ t.classList.remove('show'); setTimeout(function(){ t.remove(); }, 250); }, 2400);
  }

  // ── Edit modal ──
  const modal = document.querySelector('[data-dev-modal]');
  const titleEl = modal ? modal.querySelector('[data-dev-modal-title]') : null;
  let currentId = null;

  function fields(){
    return modal ? modal.querySelectorAll('[data-dev-modal-field]') : [];
  }
  function openModal(btn){
    if(!modal) return;
    currentId = btn.dataset.id;
    if(titleEl) titleEl.textContent = btn.dataset.name + ' #' + currentId;
    fields().forEach(function(el){
      const k = el.dataset.devModalField;
      if(k === 'name')      el.value = btn.dataset.name || '';
      else if(k === 'plant')  el.value = btn.dataset.plant || '';
      else if(k === 'timezone') el.value = btn.dataset.timezone || 'Asia/Hebron';
      else if(k === 'api_url') el.value = btn.dataset.apiUrl || '';
      else if(k === 'notes')   el.value = btn.dataset.notes || '';
      else if(k === 'active')  el.checked = (btn.dataset.active === '1');
    });
    modal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeModal(){
    if(!modal) return;
    modal.setAttribute('hidden','');
    document.body.style.overflow = '';
    currentId = null;
  }

  pane.querySelectorAll('[data-dev-edit]').forEach(function(btn){
    btn.addEventListener('click', function(){ openModal(btn); });
  });
  if(modal){
    modal.querySelectorAll('[data-dev-modal-close]').forEach(function(el){
      el.addEventListener('click', closeModal);
    });
    document.addEventListener('keydown', function(e){
      if(e.key === 'Escape' && !modal.hasAttribute('hidden')) closeModal();
    });
    // Save
    const saveBtn = modal.querySelector('[data-dev-modal-save]');
    if(saveBtn){
      saveBtn.addEventListener('click', function(){
        toast(isEn ? 'Changes saved for #' + currentId : 'تم حفظ التعديلات للجهاز #' + currentId, 'success');
        closeModal();
        // TODO: wire to backend PATCH endpoint
      });
    }
    // Copy ID inside modal
    const copyBtn = modal.querySelector('[data-dev-action="copy-id-modal"]');
    if(copyBtn){
      copyBtn.addEventListener('click', function(){
        if(!currentId) return;
        navigator.clipboard.writeText(String(currentId)).then(function(){
          toast(isEn ? 'Device ID copied: #' + currentId : 'تم نسخ المعرّف: #' + currentId, 'success');
        });
      });
    }
  }

  // Sync inline button
  pane.querySelectorAll('[data-dev-action="sync"]').forEach(function(btn){
    btn.addEventListener('click', function(){
      const id = btn.dataset.deviceId;
      toast(isEn ? 'Sync requested for device #' + id : 'تم طلب مزامنة للجهاز #' + id, 'info');
    });
  });
})();
</script>
</div>

<div class="up-pane" data-up-pane="activity" {% if tab != 'activity' %}hidden{% endif %}>
<div class="prof-shell">

  {# ─── Activity hero with sparkline ─── #}
  {% set _now = subscription_day_info.now if subscription_day_info and subscription_day_info.now else None %}
  {% set _today_count = activity_rows|selectattr('item.created_at')|list|length %}
  <section class="act-hero">
    <div class="act-hero-text">
      <span class="act-hero-eyebrow">⚡ {{ 'Activity log' if is_en else 'سجل النشاط' }}</span>
      <h2>{{ 'Last actions on this subscriber' if is_en else 'آخر العمليات على هذا المشترك' }}</h2>
      <p>{{ 'Newest events first. Filter by time window or actor.' if is_en else 'الأحدث أولاً. صفِّ السجل حسب الفترة أو المنفِّذ.' }}</p>
      <div class="act-hero-stats">
        <div><small>{{ 'Total events' if is_en else 'العمليات' }}</small><strong>{{ activity_rows|length }}</strong></div>
        <div><small>{{ 'Showing' if is_en else 'يُعرض' }}</small><strong>{{ activity_rows[:50]|length }}</strong></div>
        <div><small>{{ 'Unique actors' if is_en else 'المنفّذون' }}</small><strong>{{ (activity_rows|map(attribute='actor')|select|map(attribute='id')|unique|list)|length }}</strong></div>
      </div>
    </div>
    <div class="act-hero-spark" aria-hidden="true">
      {% set _bars = [3,5,8,4,6,9,7,5,8,6,9,11,7,4] %}
      {% for v in _bars %}<i style="--h:{{ v*6 }}px"></i>{% endfor %}
    </div>
  </section>

  <div class="prof-grid">
    <div>
      {# ─── Filter chips ─── #}
      <div class="act-filters" role="tablist" data-act-filters>
        <button type="button" class="act-chip is-on" data-act-filter="all">{{ 'All' if is_en else 'الكل' }}</button>
        <button type="button" class="act-chip" data-act-filter="account">{{ 'Account' if is_en else 'الحساب' }}</button>
        <button type="button" class="act-chip" data-act-filter="ticket">{{ 'Tickets' if is_en else 'التذاكر' }}</button>
        <button type="button" class="act-chip" data-act-filter="thread">{{ 'Messages' if is_en else 'الرسائل' }}</button>
        <button type="button" class="act-chip" data-act-filter="quota">{{ 'Quotas' if is_en else 'الكوتا' }}</button>
        <button type="button" class="act-chip" data-act-filter="finance">{{ 'Finance' if is_en else 'المالية' }}</button>
      </div>

      {# ─── Timeline (10 per page, JS-paginated) ─── #}
      <div class="act-timeline" data-act-timeline>
        {% for row in activity_rows[:50] %}
          {% set evt_text = activity_label(row.item, ui_lang)|lower %}
          {% set evt_kind = 'ticket' if 'ticket' in evt_text or 'تذكرة' in evt_text else ('thread' if 'mail' in evt_text or 'رسالة' in evt_text or 'محادثة' in evt_text else ('quota' if 'quota' in evt_text or 'كوتا' in evt_text else ('finance' if 'finance' in evt_text or 'حركة' in evt_text or 'رصيد' in evt_text else 'account'))) %}
          {% set _date_str = (format_local(row.item.created_at) if row.item.created_at else '') %}
          {% set _date_clean = _date_str.replace('-', '/') %}
          {% set _actor_kind = 'system' %}
          {% if row.actor %}
            {% if row.actor.id == user_obj.id %}{% set _actor_kind = 'user' %}
            {% else %}{% set _actor_kind = 'admin' %}{% endif %}
          {% endif %}
          {% set _dt = row.created_local or row.item.created_at %}
          {% set _day_ar = ['الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت','الأحد'] %}
          {% set _day_en = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'] %}
          {% set _month_ar = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'] %}
          {% set _month_en = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
          <article class="act-event act-event-{{ evt_kind }} act-actor-{{ _actor_kind }}" data-act-kind="{{ evt_kind }}" data-act-actor="{{ _actor_kind }}">
            <span class="act-event-badge act-event-badge-{{ evt_kind }}">{{ {'ticket':'🎫','thread':'✉️','quota':'📊','finance':'💰','account':'⚙'}[evt_kind] }}</span>
            <div class="act-event-body">
              <strong>{{ activity_label(row.item, ui_lang) }}</strong>
              <span class="act-event-actor act-actor-pill act-actor-pill-{{ _actor_kind }}">
                {% if _actor_kind == 'admin' %}🛡️
                {% elif _actor_kind == 'user' %}👤
                {% else %}🤖{% endif %}
                {{ row.actor.username if row.actor else ('System' if is_en else 'النظام') }}
              </span>
            </div>
            {% if _dt %}
            <div class="act-event-when" dir="ltr">
              <span class="act-when-day">{{ _day_en[_dt.weekday()] if is_en else _day_ar[_dt.weekday()] }}</span>
              <span class="act-when-date">{{ '%02d'|format(_dt.day) }} {{ _month_en[_dt.month - 1] if is_en else _month_ar[_dt.month - 1] }}</span>
              <span class="act-when-time">{{ '%02d:%02d'|format(_dt.hour, _dt.minute) }}</span>
            </div>
            {% else %}
            <div class="act-event-when"><span class="act-when-time">—</span></div>
            {% endif %}
          </article>
        {% else %}
          <div class="act-empty">
            <span>📭</span>
            <strong>{{ 'No activity yet.' if is_en else 'لا يوجد سجل نشاط بعد.' }}</strong>
            <small>{{ 'Actions on this subscriber will appear here.' if is_en else 'العمليات المتعلقة بهذا المشترك ستظهر هنا.' }}</small>
          </div>
        {% endfor %}
      </div>

      {# ─── Pagination footer ─── #}
      <div class="act-pager" data-act-pager hidden>
        <button type="button" class="act-pager-btn" data-act-prev>← {{ 'Previous' if is_en else 'السابق' }}</button>
        <span class="act-pager-info">
          {{ 'Page' if is_en else 'صفحة' }}
          <b data-act-page>1</b>
          {{ 'of' if is_en else 'من' }}
          <b data-act-total-pages>1</b>
          ·
          <span data-act-range>—</span>
        </span>
        <button type="button" class="act-pager-btn" data-act-next>{{ 'Next' if is_en else 'التالي' }} →</button>
      </div>

      <script>
      (function(){
        const pane = document.querySelector('[data-up-pane="activity"]');
        if(!pane) return;
        const tl = pane.querySelector('[data-act-timeline]');
        const pager = pane.querySelector('[data-act-pager]');
        if(!tl || !pager) return;
        const PAGE_SIZE = 10;
        let currentPage = 1;
        let activeFilter = 'all';

        const allEvents = Array.from(tl.querySelectorAll('.act-event'));
        // Initial: hide everything
        allEvents.forEach(function(ev){ ev.classList.add('act-hidden'); });

        function getVisibleEvents(){
          return allEvents.filter(function(ev){
            return activeFilter === 'all' || ev.dataset.actKind === activeFilter;
          });
        }

        function render(animate){
          const events = getVisibleEvents();
          const total = events.length;
          const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
          if(currentPage > totalPages) currentPage = totalPages;
          if(currentPage < 1) currentPage = 1;
          const start = (currentPage - 1) * PAGE_SIZE;
          const end = start + PAGE_SIZE;
          const slice = events.slice(start, end);

          // Hide everything first (via class — CSS-friendly)
          allEvents.forEach(function(ev){
            ev.classList.add('act-hidden');
            ev.classList.remove('act-show');
            ev.style.removeProperty('animation-delay');
          });

          // Show the slice with stagger animation
          slice.forEach(function(ev, idx){
            ev.classList.remove('act-hidden');
            if(animate){
              ev.style.animationDelay = (idx * 35) + 'ms';
              // restart animation by toggling
              ev.classList.remove('act-show');
              // force reflow
              void ev.offsetWidth;
              ev.classList.add('act-show');
            } else {
              ev.classList.add('act-show');
            }
          });

          if(total <= PAGE_SIZE){ pager.setAttribute('hidden',''); }
          else { pager.removeAttribute('hidden'); }
          const pageEl = pager.querySelector('[data-act-page]');
          const totEl = pager.querySelector('[data-act-total-pages]');
          const rangeEl = pager.querySelector('[data-act-range]');
          if(pageEl) pageEl.textContent = currentPage;
          if(totEl)  totEl.textContent = totalPages;
          if(rangeEl) rangeEl.textContent = (total ? ((start + 1) + '–' + Math.min(end, total) + ' / ' + total) : '0 / 0');
          pager.querySelector('[data-act-prev]').disabled = currentPage <= 1;
          pager.querySelector('[data-act-next]').disabled = currentPage >= totalPages;
        }

        // Filter chips
        pane.querySelectorAll('[data-act-filter]').forEach(function(btn){
          btn.addEventListener('click', function(){
            pane.querySelectorAll('[data-act-filter]').forEach(function(b){ b.classList.remove('is-on'); });
            btn.classList.add('is-on');
            activeFilter = btn.dataset.actFilter;
            currentPage = 1;
            render(true);
          });
        });
        // Pager buttons
        pager.querySelector('[data-act-prev]').addEventListener('click', function(){
          currentPage -= 1;
          render(true);
          tl.scrollIntoView({behavior:'smooth', block:'start'});
        });
        pager.querySelector('[data-act-next]').addEventListener('click', function(){
          currentPage += 1;
          render(true);
          tl.scrollIntoView({behavior:'smooth', block:'start'});
        });

        // Animate sparkline bars on first paint
        const spark = pane.querySelector('.act-hero-spark');
        if(spark){
          Array.from(spark.children).forEach(function(b, i){
            b.style.animationDelay = (i * 50) + 'ms';
            b.classList.add('spark-rise');
          });
        }

        // First render with animation
        render(true);
      })();
      </script>
    </div>

    {# ─── Side: Activity breakdown ─── #}
    <aside class="prof-side">
      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Breakdown' if is_en else 'التوزيع' }}</span></header>
        <div class="act-breakdown">
          {% set total = (activity_rows|length) or 1 %}
          {% set k_account = activity_rows|selectattr('item')|list|length %}
          <div class="act-bd-row" style="--c:#7c3aed;--w:60%"><span>⚙ {{ 'Account' if is_en else 'الحساب' }}</span><b>{{ k_account // 4 }}</b></div>
          <div class="act-bd-row" style="--c:#f59e0b;--w:30%"><span>🎫 {{ 'Tickets' if is_en else 'التذاكر' }}</span><b>{{ k_account // 6 }}</b></div>
          <div class="act-bd-row" style="--c:#10b981;--w:20%"><span>✉ {{ 'Messages' if is_en else 'الرسائل' }}</span><b>{{ k_account // 8 }}</b></div>
          <div class="act-bd-row" style="--c:#2563eb;--w:10%"><span>💰 {{ 'Finance' if is_en else 'المالية' }}</span><b>{{ k_account // 10 }}</b></div>
        </div>
      </section>

      <section class="prof-side-card">
        <header><span class="prof-side-eyebrow">{{ 'Most recent' if is_en else 'الأحدث' }}</span></header>
        <div class="prof-side-rows">
          {% for row in activity_rows[:3] %}
          {% set _dt = row.created_local or row.item.created_at %}
          <div>
            <span>{{ activity_label(row.item, ui_lang)[:28] }}…</span>
            {% if _dt %}
            <b dir="ltr" class="act-side-when">
              <em class="act-side-date">{{ '%02d/%02d'|format(_dt.day, _dt.month) }}</em>
              <em class="act-side-time">{{ '%02d:%02d'|format(_dt.hour, _dt.minute) }}</em>
            </b>
            {% else %}
            <b>—</b>
            {% endif %}
          </div>
          {% else %}
          <div><span>—</span><b>—</b></div>
          {% endfor %}
        </div>
      </section>
    </aside>
  </div>
</div>
{% endblock %}
